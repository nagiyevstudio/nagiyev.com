---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  divisionKey: 'digital-systems-ai' | 'product-design' | 'media-production';
  lang?: string;
}

const { title, divisionKey, lang = 'en' } = Astro.props;

// Division-specific accent color
const accentColors = {
  'digital-systems-ai': 'var(--division-ai)',
  'product-design': 'var(--division-design)',
  'media-production': 'var(--division-media)',
};

const accentColor = accentColors[divisionKey];
---

<BaseLayout title={title} lang={lang}>
  <div class="division-hero" style={`--division-accent: ${accentColor}`}>
    <div class="container">
      <span class="division-label">
        {divisionKey === 'digital-systems-ai' && 'Digital Systems & AI'}
        {divisionKey === 'product-design' && 'Product & Design'}
        {divisionKey === 'media-production' && 'Media Production'}
      </span>
      <slot name="hero" />
    </div>
  </div>
  
  <div class="division-content">
    <slot />
  </div>
</BaseLayout>

<style>
  .division-hero {
    padding: var(--space-16) 0;
    border-bottom: var(--border-thin);
    background: linear-gradient(135deg, var(--division-accent) 0%, transparent 100%);
    background-size: 100% 100%;
  }
  
  .division-label {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    background: var(--division-accent);
    color: var(--color-text-on-dark);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-6);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
  
  .division-hero :global(h1) {
    font-size: clamp(var(--text-4xl), 6vw, var(--text-6xl));
    margin-bottom: var(--space-6);
    color: var(--color-text);
  }
  
  .division-hero :global(.hero-lead) {
    font-size: var(--text-xl);
    color: var(--color-text-secondary);
    max-width: 60ch;
    line-height: var(--leading-relaxed);
  }
  
  .division-content {
    padding: var(--space-20) 0;
  }
</style>
