---
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { Icon } from 'astro-icon/components';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  lang?: string; // 'en' | 'az'
}

const { title, description = 'Nagiyev Studio — AI-powered digital systems, product design and media production.', lang = 'en' } = Astro.props;
const locale = lang || 'en';
const prefix = locale === 'az' ? '/az' : '';
const currentPath = Astro.url.pathname;

// Determine which nav item is active
function isActive(href: string): boolean {
  const clean = currentPath.replace(/\/$/, '') || '/';
  const target = href.replace(/\/$/, '') || '/';
  if (target === '/' || target === '/az') {
    return clean === target;
  }
  return clean.startsWith(target);
}

const navItems = [
  { href: `${prefix}/`, label: locale === 'az' ? 'Ana Səhifə' : 'Home' },
  { href: `${prefix}/digital-systems-ai/`, label: locale === 'az' ? 'Rəqəmsal Sistemlər' : 'Digital Systems' },
  { href: `${prefix}/product-design/`, label: locale === 'az' ? 'Dizayn' : 'Design' },
  { href: `${prefix}/media-production/`, label: locale === 'az' ? 'Media' : 'Media' },
  { href: `${prefix}/about/`, label: locale === 'az' ? 'Haqqında' : 'About' },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/common/og-default.jpg" />
    <meta property="og:url" content={`https://nagiyevstudio.com${Astro.url.pathname}`} />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    
    <link rel="canonical" href={`https://nagiyevstudio.com${Astro.url.pathname}`} />
    <title>{title}</title>
    
    <!-- Preload fonts if needed -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={`{
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Nagiyev Studio",
      "url": "https://nagiyevstudio.com",
      "logo": "https://nagiyevstudio.com/images/common/logo.svg",
      "sameAs": []
    }`}></script>
    <noscript>
      <style>
        .reveal-el, .animate-on-scroll, .hero-title, .hero-subtitle, .cta-button {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a href="#main" class="sr-only">Skip to content</a>
    
    <header class="site-header">
      <div class="container header-inner">
        <a href={`${prefix}/`} class="logo" aria-label="Nagiyev Studio Home">
          <img src="/images/common/logo.svg" alt="Nagiyev Studio" class="logo-image" />
        </a>
        
        <nav class="main-nav" aria-label="Main navigation">
          {navItems.map(item => (
            <a href={item.href} class={`nav-link${isActive(item.href) ? ' nav-link--active' : ''}`}>{item.label}</a>
          ))}
        </nav>
        
        <LanguageSwitcher currentLocale={locale} />
        
        <button class="mobile-menu-toggle" aria-label="Toggle menu" id="mobile-menu-toggle">
          <span class="hamburger"></span>
        </button>
      </div>
      
      <!-- Mobile Menu Panel -->
      <div class="mobile-menu" id="mobile-menu">
        <nav class="mobile-nav" aria-label="Mobile navigation">
          {navItems.map(item => (
            <a href={item.href} class={`mobile-nav-link${isActive(item.href) ? ' mobile-nav-link--active' : ''}`}>{item.label}</a>
          ))}
        </nav>
        <div class="mobile-menu-footer">
          <LanguageSwitcher currentLocale={locale} />
        </div>
      </div>
    </header>
    
    <main id="main">
      <slot />
    </main>
    
    <footer class="site-footer">
      <div class="container footer-content">
        <div class="footer-brand">
          <img src="/images/common/logo.svg" alt="Nagiyev Studio" class="footer-logo-image" />
          <p class="footer-tagline">AI-powered digital systems, product design and media production.</p>
        </div>
        
        <nav class="footer-nav" aria-label="Footer navigation">
          {navItems.map(item => (
            <a href={item.href}>{item.label}</a>
          ))}
          <a href={`${prefix}/contact/`}>{locale === 'az' ? 'Əlaqə' : 'Contact'}</a>
        </nav>
        
        <div class="footer-contact">
          <a href="https://wa.me/" class="contact-link contact-icon-link" aria-label="WhatsApp">
            <Icon name="lucide:message-circle" class="contact-icon" />
          </a>
          <a href="https://t.me/" class="contact-link contact-icon-link" aria-label="Telegram">
            <Icon name="lucide:send" class="contact-icon" />
          </a>
          <a href="tel:+994" class="contact-link contact-icon-link" aria-label="Phone">
            <Icon name="lucide:phone" class="contact-icon" />
          </a>
        </div>
        
        <p class="footer-copyright">&copy; 2026 Nagiyev Studio. All rights reserved.</p>
      </div>
    </footer>
    <!-- Mobile Menu Script -->
    <script>
      function initMobileMenu() {
        const toggle = document.getElementById('mobile-menu-toggle');
        const menu = document.getElementById('mobile-menu');
        const header = document.querySelector('.site-header');
        if (!toggle || !menu) return;

        toggle.addEventListener('click', () => {
          const isOpen = menu.classList.contains('mobile-menu--open');
          if (isOpen) {
            menu.classList.remove('mobile-menu--open');
            toggle.classList.remove('mobile-menu-toggle--open');
            document.body.style.overflow = '';
          } else {
            menu.classList.add('mobile-menu--open');
            toggle.classList.add('mobile-menu-toggle--open');
            document.body.style.overflow = 'hidden';
          }
        });

        // Close menu when a link is clicked
        menu.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            menu.classList.remove('mobile-menu--open');
            toggle.classList.remove('mobile-menu-toggle--open');
            document.body.style.overflow = '';
          });
        });
      }

      document.addEventListener('astro:page-load', initMobileMenu);
      initMobileMenu();
    </script>
  </body>
</html>

<style>
  /* ── Header ── */
  
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg);
    border-bottom: var(--border-thin);
  }
  
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-4) var(--space-6);
  }
  
  .logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }
  
  .logo-image {
    height: 36px;
    width: auto;
    max-width: 200px;
    display: block;
  }
  
  .footer-logo-image {
    height: 44px;
    width: auto;
    display: block;
    
  }
  
  .main-nav {
    display: none;
    gap: var(--space-6);
  }
  
  .nav-link {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    position: relative;
  }
  
  .nav-link:hover {
    color: var(--color-text);
  }
  
  .nav-link--active {
    color: var(--color-text);
  }
  
  .nav-link--active::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-accent);
    border-radius: 1px;
  }
  
  /* ── Mobile Menu Toggle ── */
  
  .mobile-menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2);
    background: transparent;
    border: none;
    cursor: pointer;
    width: 36px;
    height: 36px;
    position: relative;
    z-index: 110;
  }
  
  .hamburger {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--color-text);
    position: relative;
    transition: background 0.2s ease;
  }
  
  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    width: 20px;
    height: 2px;
    background: var(--color-text);
    left: 0;
    transition: transform 0.3s ease, top 0.3s ease;
  }
  
  .hamburger::before { top: -6px; }
  .hamburger::after { top: 6px; }
  
  /* Hamburger → X animation */
  .mobile-menu-toggle--open .hamburger {
    background: transparent;
  }
  
  .mobile-menu-toggle--open .hamburger::before {
    top: 0;
    transform: rotate(45deg);
  }
  
  .mobile-menu-toggle--open .hamburger::after {
    top: 0;
    transform: rotate(-45deg);
  }
  
  /* ── Mobile Menu Panel ── */
  
  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--color-bg);
    z-index: 99;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: var(--space-16) var(--space-6);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  
  .mobile-menu--open {
    opacity: 1;
    visibility: visible;
  }
  
  .mobile-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }
  
  .mobile-nav-link {
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    letter-spacing: var(--tracking-tight);
  }
  
  .mobile-nav-link:hover {
    color: var(--color-text);
  }
  
  .mobile-nav-link--active {
    color: var(--color-text);
    position: relative;
  }
  
  .mobile-nav-link--active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 25%;
    right: 25%;
    height: 2px;
    background: var(--color-accent);
    border-radius: 1px;
  }
  
  .mobile-menu-footer {
    margin-top: var(--space-10);
  }
  
  /* ── Footer ── */
  
  .site-footer {
    margin-top: var(--space-24);
    padding: var(--space-12) 0;
    border-top: var(--border-thin);
    background: var(--color-bg);
  }
  
  .footer-content {
    display: grid;
    gap: var(--space-8);
    text-align: center;
  }
  
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  
  .footer-tagline {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    max-width: 40ch;
    margin: 0 auto;
  }
  
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4) var(--space-6);
  }
  
  .footer-nav a {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }
  
  .footer-nav a:hover {
    color: var(--color-text);
  }
  
  .footer-contact {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  
  .contact-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-4);
    border: var(--border-thin);
    border-radius: var(--radius-sm);
    transition: background var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  }
  
  .contact-icon-link {
    padding: var(--space-2);
    border-radius: 50%;
  }

  .contact-icon {
    width: 20px;
    height: 20px;
  }
  
  .contact-link:hover {
    background: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
  }
  
  .footer-copyright {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-4);
  }
  
  /* ── Desktop ── */
  
  @media (min-width: 768px) {
    .header-inner {
      padding: var(--space-5) var(--space-6);
    }
    
    .main-nav {
      display: flex;
    }
    
    .mobile-menu-toggle {
      display: none;
    }
    
    .mobile-menu {
      display: none;
    }
    
    .footer-content {
      text-align: left;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-12);
    }
    
    .footer-brand {
      grid-column: 1 / -1;
      text-align: center;
    }
    
    .footer-logo-image {
      margin: 0 0 var(--space-4) 0;
    }
    
    .footer-nav {
      justify-content: flex-start;
    }
    
    .footer-contact {
      justify-content: flex-end;
    }
    
    .footer-copyright {
      grid-column: 1 / -1;
      text-align: center;
      margin-top: var(--space-8);
    }
  }
</style>
