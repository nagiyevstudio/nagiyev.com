---
import DivisionLayout from '../layouts/DivisionLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const division = await getCollection('divisions', ({ data }) => data.key === 'product-design');
const divisionData = division[0]?.data;

const designProjects = await getCollection('projects', ({ data }) => 
  data.division === 'product-design' && data.published !== false
);

const projects = designProjects.map((p: CollectionEntry<'projects'>) => ({
  slug: p.slug,
  title: p.data.title,
  subtitle: p.data.subtitle,
  client: p.data.client,
  year: p.data.year,
  cover: p.data.cover,
}));
---

<DivisionLayout title={divisionData?.title || 'Product & Design'} divisionKey="product-design" lang="en">
  <fragment slot="hero">
    <h1>{divisionData?.title}</h1>
    <p class="hero-lead">{divisionData?.subtitle}</p>
  </fragment>
  
  <section class="section">
    <div class="container">
      <h2 class="section-title">What We Design</h2>
      <div class="content-block">
        <p>{divisionData?.description}</p>
      </div>
    </div>
  </section>
  
  <section class="section section--alt">
    <div class="container">
      <h2 class="section-title">Capabilities</h2>
      <ul class="capabilities-list">
        {divisionData?.capabilities.map(cap => (
          <li class="capability-item">
            <span class="capability-bullet"></span>
            <span>{cap}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
  
  <section class="section">
    <div class="container">
      <h2 class="section-title">Selected Work</h2>
      {projects.length > 0 ? (
        <div class="grid grid--3">
          {projects.map(p => (
            <a href={`/projects/${p.slug}/`} class="project-card">
              {p.cover && (
                <div class="project-cover">
                  <img src={p.cover} alt={p.title} loading="lazy" />
                </div>
              )}
              <div class="project-content">
                <h3>{p.title}</h3>
                <p class="project-subtitle">{p.subtitle}</p>
                {p.client && <p class="project-meta">{p.client}{p.year && `, ${p.year}`}</p>}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="no-content">No projects yet. Check back soon.</p>
      )}
    </div>
  </section>
  
  <section class="section section--alt">
    <div class="container container--narrow">
      <h2 class="section-title">Our Approach</h2>
      <p class="lead">{divisionData?.approach || 'We craft digital products that are intuitive, beautiful and built to scale.'}</p>
    </div>
  </section>
  
  <section class="section cta-section">
    <div class="container">
      <h2 class="section-title">Let's create something beautiful</h2>
      <a href="/contact/" class="cta-button">Get in touch</a>
    </div>
  </section>
</DivisionLayout>

<style>
  .section { padding: var(--space-16) 0; border-bottom: var(--border-thin); }
  .section--alt { background: var(--color-bg-card); }
  .section-title { font-size: var(--text-3xl); margin-bottom: var(--space-8); }
  .content-block { max-width: 70ch; }
  .content-block p { font-size: var(--text-lg); line-height: var(--leading-relaxed); color: var(--color-text-secondary); }
  .capabilities-list { display: grid; grid-template-columns: 1fr; gap: var(--space-4); }
  @media (min-width: 640px) { .capabilities-list { grid-template-columns: repeat(2, 1fr); } }
  .capability-item { display: flex; align-items: center; gap: var(--space-3); font-size: var(--text-base); }
  .capability-bullet { width: 8px; height: 8px; background: var(--division-design); border-radius: 50%; flex-shrink: 0; }
  .grid { display: grid; gap: var(--space-6); }
  .grid--3 { grid-template-columns: 1fr; }
  @media (min-width: 640px) { .grid--3 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid--3 { grid-template-columns: repeat(3, 1fr); } }
  .project-card { display: block; background: var(--color-bg-card); border: var(--border-thin); border-radius: var(--radius-lg); overflow: hidden; transition: border-color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast); }
  .project-card:hover { border-color: var(--color-text); transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .project-cover { aspect-ratio: 16/9; background: var(--color-bg-hover); overflow: hidden; }
  .project-cover img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--transition-slow); }
  .project-card:hover .project-cover img { transform: scale(1.05); }
  .project-content { padding: var(--space-6); }
  .project-content h3 { font-size: var(--text-lg); margin-bottom: var(--space-2); }
  .project-subtitle { font-size: var(--text-sm); color: var(--color-text-secondary); margin-bottom: var(--space-3); }
  .project-meta { font-size: var(--text-xs); color: var(--color-text-muted); }
  .no-content { color: var(--color-text-secondary); font-style: italic; }
  .lead { font-size: var(--text-xl); line-height: var(--leading-relaxed); color: var(--color-text-secondary); }
  .cta-section { text-align: center; }
  .cta-button { display: inline-block; padding: var(--space-4) var(--space-8); background: var(--division-design); color: var(--color-text-on-dark); font-size: var(--text-base); font-weight: var(--weight-semibold); border-radius: var(--radius-md); transition: background var(--transition-fast), transform var(--transition-fast); }
  .cta-button:hover { background: var(--division-design); filter: brightness(0.9); transform: translateY(-2px); }
</style>
