---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

const divisionEntries = await getCollection('divisions', ({ data, id }) => data.key === 'product-design' && id.startsWith('en/'));
const divisionEntry = divisionEntries[0];
const d = divisionEntry?.data;

const designProjects = await getCollection('projects', ({ data }) =>
  data.division === 'product-design'
);

const projects = designProjects.map((p) => ({
  slug: p.id,
  title: p.data.title,
  summary: p.data.summary,
  client: p.data.client,
  year: p.data.year,
  cover: p.data.cover,
  tags: p.data.tags,
}));
---

<BaseLayout title={d?.title || 'Design & Branding'} lang="en">
  <!-- ── Hero Section ── -->
  <section class="hero">
    <div class="hero-background">
      <img src={d?.cover || "/images/divisions/design-hero.jpg"} alt="Design & Branding Background" class="hero-bg-image" />
    </div>
    <div class="hero-overlay"></div>
    
    <div class="container">
      <div class="hero-content">
        <div class="hero-badge reveal-el">Division</div>
        <h1 class="hero-title reveal-el" style="transition-delay: 100ms;">
          {d?.hero_headline || "Design that makes products, businesses and ideas clear."}
        </h1>
        <p class="hero-subtitle reveal-el" style="transition-delay: 200ms;">
          {d?.hero_supporting || "We create brand identities, product interfaces and visual communication systems for businesses, organizations and public projects — with a focus on clarity, trust and real audience understanding."}
        </p>
      </div>
    </div>
  </section>

  <!-- ── Main Positioning ── -->
  <section class="section section--philosophy">
    <div class="container container--narrow reveal-el">
      <div class="philosophy-content" style="display: flex; flex-direction: column; align-items: center; text-align: center;">
        <Icon name="lucide:pen-tool" class="quote-icon" style="color: var(--division-design);" />
        <p class="philosophy-text" style="max-width: 800px; margin: 0 auto;">
          The question is not only “how should it look?”<br/>The more important question is: “How will the user understand it, trust it and use it?”
        </p>
        <div class="prose-text mt-8" style="max-width: 700px; margin: 2rem auto 0 auto; font-size: var(--text-lg); color: var(--color-text-secondary); line-height: var(--leading-relaxed);">
          <p>Good design should make the product, service or message clearer. It should reduce confusion, structure attention and help different audiences quickly understand what matters.</p>
          <p style="margin-top: 1rem;"><strong>Design at Nagiyev Studio is a way to make a business, product, organization or idea understandable, trustworthy and visually consistent.</strong></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Services Strip ── -->
  {d?.services && d.services.length > 0 && (
    <section class="services-strip reveal-el">
      <div class="container">
        <div class="services-list">
          {d.services.map((s: string) => (
            <span class="service-tag">{s}</span>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── Capabilities ── -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header reveal-el">
        <span class="section-tag" style="color: var(--division-design);">Scope</span>
        <h2 class="section-title">What This Direction Covers</h2>
        <p class="section-subtitle">From complete brand identity and UI/UX to pitch decks, annual reports, social media systems and scientific communication.</p>
      </div>
      
      {d?.capabilities && (
        <div class="capabilities-grid reveal-el" style="transition-delay: 100ms;">
          {d.capabilities.map((cap: string) => (
            <div class="capability-item">
              <Icon name="lucide:check-circle-2" class="cap-icon" />
              <span>{cap}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- ── Deep Dive: Experience & Focus Areas ── -->
  <section class="section">
    <div class="container">
      <div class="section-header reveal-el">
        <span class="section-tag" style="color: var(--division-design);">Focus Areas</span>
        <h2 class="section-title">Experience & Approach</h2>
      </div>

      <div class="focus-areas">
        <!-- Area 1 -->
        <div class="focus-card reveal-el">
          <div class="focus-icon"><Icon name="lucide:fingerprint" /></div>
          <h3>Brand Identity</h3>
          <p>Complete brand creation from the ground up. The goal is not to create a standalone logo, but to build a visual identity that can work across real business situations: website, social media, documents, presentations, signage, campaigns and sales materials.</p>
        </div>

        <!-- Area 2 -->
        <div class="focus-card reveal-el" style="transition-delay: 100ms;">
          <div class="focus-icon"><Icon name="lucide:layout" /></div>
          <h3>Product Design & UI/UX</h3>
          <p>Designing interfaces for web, mobile and terminal-based systems. A good product designer should be able to package an idea for users and translate it into something developers can build clearly.</p>
        </div>

        <!-- Area 3 -->
        <div class="focus-card reveal-el" style="transition-delay: 200ms;">
          <div class="focus-icon"><Icon name="lucide:lightbulb" /></div>
          <h3>Product Thinking</h3>
          <p>Many local businesses reduce product design to visual styling. Product design is broader: understanding the audience, defining user flows, simplifying complex logic, and connecting business goals with technical implementation.</p>
        </div>

        <!-- Area 4 -->
        <div class="focus-card reveal-el">
          <div class="focus-icon"><Icon name="lucide:book-open" /></div>
          <h3>Presentations & Reports</h3>
          <p>Turning complex information into structured, visually clear and persuasive communication — from pitch decks and business presentations to enterprise-level materials, annual reports, and book design.</p>
        </div>

        <!-- Area 5 -->
        <div class="focus-card reveal-el" style="transition-delay: 100ms;">
          <div class="focus-icon"><Icon name="lucide:share-2" /></div>
          <h3>Social & Campaign Systems</h3>
          <p>Social media as a visual communication system connected to the brand, product, campaign and business goal, rather than just "single post design".</p>
        </div>

        <!-- Area 6 -->
        <div class="focus-card reveal-el" style="transition-delay: 200ms;">
          <div class="focus-icon"><Icon name="lucide:sparkles" /></div>
          <h3>Complex Public Communication</h3>
          <p>Visualizing complex topics where design must help people understand. This is especially relevant for science, education, public communication, social initiatives, finance, and industrial topics.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Main Value ── -->
  <section class="section section--philosophy">
    <div class="container container--narrow reveal-el">
      <div class="philosophy-content">
        <h2 class="section-title mb-8" style="text-align: center;">Main Value for Clients</h2>
        <ul class="value-list">
          <li><Icon name="lucide:arrow-right" class="value-icon" /> Making the business look serious and trustworthy</li>
          <li><Icon name="lucide:arrow-right" class="value-icon" /> Turning complex ideas into clear visual communication</li>
          <li><Icon name="lucide:arrow-right" class="value-icon" /> Creating a consistent visual system across channels</li>
          <li><Icon name="lucide:arrow-right" class="value-icon" /> Helping users understand a product or service faster</li>
          <li><Icon name="lucide:arrow-right" class="value-icon" /> Connecting brand, interface, content and marketing into one system</li>
          <li><Icon name="lucide:arrow-right" class="value-icon" /> Building design systems that scale beyond one post or one logo</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Selected Work ── -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header reveal-el">
        <span class="section-tag" style="color: var(--division-design);">Case Studies</span>
        <h2 class="section-title">Selected Work</h2>
      </div>
      
      {projects.length > 0 ? (
        <div class="grid grid--3">
          {projects.map((p: any, i: number) => (
            <a href={`/projects/${p.slug}`} class="project-card reveal-el" style={`transition-delay: ${i * 100}ms;`}>
              {p.cover ? (
                <div class="project-card__image">
                  <img src={p.cover} alt={p.title} loading="lazy" />
                </div>
              ) : (
                <div class="project-card__placeholder">
                  <Icon name="lucide:image" class="placeholder-icon" />
                </div>
              )}
              <div class="project-card__content">
                <div class="project-card__header">
                  <h3>{p.title}</h3>
                  {p.year && <span class="project-year">{p.year}</span>}
                </div>
                {p.client && <span class="project-client">{p.client}</span>}
                <p>{p.summary}</p>
                {p.tags && p.tags.length > 0 && (
                  <div class="project-tags">
                    {p.tags.slice(0, 3).map((tag: string) => (
                      <span class="project-tag">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="reveal-el">
          <p class="text-muted italic">Case studies coming soon.</p>
        </div>
      )}
    </div>
  </section>

  <!-- ── Good Fit ── -->
  {d?.good_fit && d.good_fit.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="two-col-layout reveal-el">
          <div class="two-col-left">
            <span class="section-tag" style="color: var(--division-design);">Fit</span>
            <h2 class="section-title">When this is a good fit</h2>
            <p class="section-subtitle">This direction is suitable for clients who need:</p>
          </div>
          <div class="two-col-right">
            <ul class="fit-list">
              {d.good_fit.map((item: string, i: number) => (
                <li class="fit-item reveal-el" style={`transition-delay: ${i * 50}ms;`}>
                  <Icon name="lucide:check" class="fit-check" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ── Contact CTA ── -->
  <section class="section section--cta">
    <div class="container reveal-el">
      <div class="cta-card">
        <div class="cta-card__content">
          <span class="section-tag" style="color: rgba(255,255,255,0.7); margin-bottom: 1rem; display: block; text-align: center;">Contact</span>
          <h2>{d?.cta_text || "Contact us"}</h2>
          <p>{d?.cta_supporting || "Tell us what you need to package: a brand, product, interface, presentation, campaign or complex idea. We can help turn it into a clear visual system."}</p>
          <a href="/contact" class="btn btn--primary btn--large" style="background: var(--division-design);">
            Get in touch
            <Icon name="lucide:arrow-right" class="icon" />
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
// Scroll reveal animation
const initReveal = () => {
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('reveal-active');
        observer.unobserve(entry.target);
      }
    });
  }, { rootMargin: '0px 0px -50px 0px', threshold: 0.1 });

  document.querySelectorAll('.reveal-el').forEach(el => {
    observer.observe(el);
  });
};

document.addEventListener('astro:page-load', initReveal);
initReveal();
</script>

<style>
  /* ── Hero Section ── */
  .hero {
    position: relative;
    padding: var(--space-32) 0 var(--space-24);
    color: var(--color-text-on-dark);
    overflow: hidden;
    min-height: 70vh;
    display: flex;
    align-items: center;
  }

  .hero-background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0.8) 100%);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 800px;
  }

  .hero-badge {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    background: var(--division-design);
    color: #fff;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-6);
  }

  .hero-title {
    font-size: clamp(var(--text-4xl), 5vw, var(--text-6xl));
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-6);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .hero-subtitle {
    font-size: var(--text-xl);
    line-height: var(--leading-relaxed);
    color: rgba(255, 255, 255, 0.8);
    max-width: 700px;
  }

  /* ── Sections ── */
  .section {
    padding: var(--space-24) 0;
  }

  .section--alt {
    background: var(--color-bg-hover);
  }

  .section-header {
    margin-bottom: var(--space-16);
    max-width: 800px;
  }

  .section-tag {
    display: block;
    font-size: var(--text-xs);
    text-transform: uppercase;
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-2);
  }

  .section-title {
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-4);
  }

  .section-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  /* ── Philosophy ── */
  .section--philosophy {
    border-top: var(--border-thin);
    border-bottom: var(--border-thin);
    background: var(--color-bg-card);
  }

  .philosophy-content {
    padding: var(--space-10) 0;
  }

  .quote-icon {
    width: 48px;
    height: 48px;
    margin: 0 auto var(--space-6);
    display: block;
  }

  .philosophy-text {
    font-size: var(--text-2xl);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    font-weight: var(--weight-medium);
    text-align: center;
  }

  .prose-text p {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .value-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .value-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    padding: var(--space-4);
    background: var(--color-bg-hover);
    border-radius: var(--radius-md);
  }

  .value-icon {
    width: 24px;
    height: 24px;
    color: var(--division-design);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .mt-8 { margin-top: var(--space-8); }
  .mt-4 { margin-top: var(--space-4); }
  .mb-8 { margin-bottom: var(--space-8); }

  /* ── Services Strip ── */
  .services-strip {
    padding: var(--space-8) 0;
    background: var(--color-bg);
    border-bottom: var(--border-thin);
  }

  .services-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
  }

  .service-tag {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    background: var(--color-bg-card);
    border: var(--border-thin);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    font-weight: var(--weight-medium);
  }

  /* ── Capabilities Grid ── */
  .capabilities-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 640px) {
    .capabilities-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .capabilities-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .capability-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--color-bg-card);
    border: var(--border-thin);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .cap-icon {
    width: 20px;
    height: 20px;
    color: var(--division-design);
    flex-shrink: 0;
  }

  /* ── Focus Areas ── */
  .focus-areas {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  @media (min-width: 768px) {
    .focus-areas { grid-template-columns: repeat(2, 1fr); }
  }

  .focus-card {
    background: var(--color-bg-card);
    border: var(--border-thin);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
  }

  .focus-icon {
    width: 48px;
    height: 48px;
    background: color-mix(in srgb, var(--division-design) 10%, var(--color-bg-card));
    color: var(--division-design);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-6);
  }

  .focus-icon :global(svg) {
    width: 24px;
    height: 24px;
  }

  .focus-card h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
  }

  .focus-card p {
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  /* ── Selected Work Cards ── */
  .grid--3 {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .grid--3 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid--3 { grid-template-columns: repeat(3, 1fr); } }

  .project-card {
    background: var(--color-bg-card);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: var(--border-thin);
    transition: all var(--transition-base);
    display: flex;
    flex-direction: column;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--division-design);
  }

  .project-card__image {
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .project-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .project-card:hover .project-card__image img {
    transform: scale(1.05);
  }

  .project-card__placeholder {
    aspect-ratio: 16/9;
    background: var(--color-bg-hover);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder-icon {
    width: 48px;
    height: 48px;
    color: var(--color-border);
  }

  .project-card__content {
    padding: var(--space-6);
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .project-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-2);
  }

  .project-card h3 {
    font-size: var(--text-xl);
    margin: 0;
  }

  .project-year {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-weight: var(--weight-medium);
  }

  .project-client {
    font-size: var(--text-xs);
    text-transform: uppercase;
    color: var(--division-design);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-3);
    display: block;
  }

  .project-card p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
    flex-grow: 1;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: auto;
  }

  .project-tag {
    font-size: var(--text-xs);
    padding: 2px var(--space-2);
    background: var(--color-bg-hover);
    color: var(--color-text-secondary);
    border-radius: var(--radius-sm);
  }

  /* ── Two Column (Good Fit) ── */
  .two-col-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
  }
  @media (min-width: 768px) {
    .two-col-layout { grid-template-columns: 1fr 1fr; }
  }

  .fit-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .fit-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--color-bg-card);
    border: var(--border-thin);
    border-radius: var(--radius-md);
  }

  .fit-check {
    width: 24px;
    height: 24px;
    color: var(--division-design);
    flex-shrink: 0;
  }

  .fit-item span {
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: var(--leading-snug);
  }

  /* ── CTA Card ── */
  .cta-card {
    background: var(--color-bg-inverted);
    color: var(--color-text-on-dark);
    padding: var(--space-16) var(--space-10);
    border-radius: var(--radius-xl);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .cta-card h2 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
  }

  .cta-card p {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    margin: 0 auto var(--space-10);
    max-width: 600px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    font-weight: var(--weight-medium);
    transition: all var(--transition-base);
    cursor: pointer;
    text-decoration: none;
    color: var(--color-text-on-dark);
  }

  .btn--primary:hover {
    filter: brightness(1.2);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px -10px var(--division-design);
  }

  .btn--large {
    padding: var(--space-4) var(--space-10);
    font-size: var(--text-lg);
  }

  .btn .icon {
    width: 18px;
    height: 18px;
    transition: transform var(--transition-fast);
  }

  .btn:hover .icon {
    transform: translateX(3px);
  }

  /* ── Scroll Reveal ── */
  .reveal-el {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal-active {
    opacity: 1;
    transform: translateY(0);
  }
</style>
