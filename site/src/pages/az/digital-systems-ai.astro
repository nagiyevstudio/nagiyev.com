---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

const divisionEntries = await getCollection('divisions', ({ data, id }) => data.key === 'digital-systems-ai' && id.startsWith('az/'));
const divisionEntry = divisionEntries[0];
const d = divisionEntry?.data;

const aiProjects = await getCollection('projects', ({ data, id }) =>
  data.division === 'digital-systems-ai' && id.startsWith('az/')
);

const projects = aiProjects.map((p) => ({
  slug: p.id.replace(/^az\//, ''),
  title: p.data.title,
  summary: p.data.summary,
  client: p.data.client,
  year: p.data.year,
  cover: p.data.cover,
  tags: p.data.tags,
}));
---

<BaseLayout title={d?.title || 'Rəqəmsal Sistemlər və AI'} lang="az">
  <!-- ── Hero Section ── -->
  <section class="hero">
    <div class="hero-background">
      <img src={d?.cover || "/images/divisions/ai-hero.jpg"} alt="Digital Systems & AI Background" class="hero-bg-image" />
    </div>
    <div class="hero-overlay"></div>
    
    <div class="container">
      <div class="hero-content">
        <div class="hero-badge reveal-el">İstiqamət</div>
        <h1 class="hero-title reveal-el" style="transition-delay: 100ms;">
          {d?.hero_headline || "Real biznes məntiqi əsasında qurulan rəqəmsal sistemlər."}
        </h1>
        <p class="hero-subtitle reveal-el" style="transition-delay: 200ms;">
          {d?.hero_supporting || "Biz sadəcə vizual onlayn mövcudluqdan daha çoxuna ehtiyacı olan bizneslər və təşkilatlar üçün veb-saytlar, platformalar, daxili alətlər, avtomatlaşdırma və AI-dəstəkli sistemlər layihələndiririk və hazırlayırıq."}
        </p>
      </div>
    </div>
  </section>

  <!-- ── Main Positioning ── -->
  <section class="section section--philosophy">
    <div class="container container--narrow reveal-el">
      <div class="philosophy-content" style="display: flex; flex-direction: column; align-items: center; text-align: center;">
        <Icon name="lucide:cpu" class="quote-icon" style="color: var(--division-ai);" />
        <p class="philosophy-text" style="max-width: 800px; margin: 0 auto;">
          Rəqəmsal Sistemlər bizneslər, təşkilatlar və ictimai layihələr üçün praktik rəqəmsal infrastrukturun qurulmasıdır.
        </p>
        <div class="prose-text mt-8" style="max-width: 700px; margin: 2rem auto 0 auto; font-size: var(--text-lg); color: var(--color-text-secondary); line-height: var(--leading-relaxed);">
          <p>Bu iş yalnız kod yazmaq və ya veb-sayt yaratmaqla məhdudlaşmır. Bir çox hallarda bura müştərinin real proseslərini anlamaq, biznes məntiqini layihələndirmək, iş axınlarını strukturlaşdırmaq, konsaltinq, mexaniki əməliyyatların rəqəmsallaşdırılması və proqram təminatı qatının bu ehtiyaclar ətrafında qurulması daxildir.</p>
          <p style="margin-top: 1rem;"><strong>Məqsəd faydalı, idarə oluna bilən və təşkilatın real iş prinsipi ilə əlaqəli sistemlər yaratmaqdır.</strong></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Services Strip ── -->
  {d?.services && d.services.length > 0 && (
    <section class="services-strip reveal-el">
      <div class="container">
        <div class="services-list">
          {d.services.map((s: string) => (
            <span class="service-tag">{s}</span>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── Capabilities ── -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header reveal-el">
        <span class="section-tag" style="color: var(--division-ai);">Məqsəd</span>
        <h2 class="section-title">Bu istiqamət nələri əhatə edir</h2>
        <p class="section-subtitle">Veb-saytlar və portallardan tutmuş CRM məntiqi, istehsalat hesabatları, fintech məhsulları və AI iş axınlarına qədər.</p>
      </div>
      
      {d?.capabilities && (
        <div class="capabilities-grid reveal-el" style="transition-delay: 100ms;">
          {d.capabilities.map((cap: string) => (
            <div class="capability-item">
              <Icon name="lucide:check-circle-2" class="cap-icon" />
              <span>{cap}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- ── Deep Dive: Experience & Focus Areas ── -->
  <section class="section">
    <div class="container">
      <div class="section-header reveal-el">
        <span class="section-tag" style="color: var(--division-ai);">Təcrübə</span>
        <h2 class="section-title">Təcrübə və Fokus Sahələri</h2>
      </div>

      <div class="focus-areas">
        <!-- Area 1 -->
        <div class="focus-card reveal-el">
          <div class="focus-icon"><Icon name="lucide:history" /></div>
          <h3>Təcrübə Keçmişi</h3>
          <p>{d?.experience_summary}</p>
        </div>

        <!-- Area 2 -->
        <div class="focus-card reveal-el" style="transition-delay: 100ms;">
          <div class="focus-icon"><Icon name="lucide:factory" /></div>
          <h3>Sənaye və Biznes Sistemləri</h3>
          <p>Böyük istehsalat müəssisələri üçün istehsalatın izlənilməsi, keyfiyyətə nəzarət, texniki tərəqqi və rəhbərlik üçün hesabatlılıq sistemlərini əhatə edən mürəkkəb əməliyyat mühitləri üzrə təcrübəmiz var.</p>
          <p class="mt-4">Bura ISO 9001 keyfiyyət idarəetməsi və laboratoriya prosesləri ilə bağlı standartlaşdırma işləri daxildir.</p>
        </div>

        <!-- Area 3 -->
        <div class="focus-card reveal-el" style="transition-delay: 200ms;">
          <div class="focus-icon"><Icon name="lucide:workflow" /></div>
          <h3>CRM və Proses Məntiqi</h3>
          <p>Bir çox təşkilatın yalnız veb-sayta deyil, strukturlaşdırılmış axınlara ehtiyacı var: sorğular, istifadəçilər, qeydlər, statuslar, kommunikasiya, hesabatlar və daxili nəzarət.</p>
          <p class="mt-4">Biz CRM və təhsil idarəetmə sistemləri, daxili iş axınları və strukturlaşdırılmış əməliyyat alətləri üçün biznes məntiqi qururuq.</p>
        </div>

        <!-- Area 4 -->
        <div class="focus-card reveal-el">
          <div class="focus-icon"><Icon name="lucide:bot" /></div>
          <h3>AI və Avtomatlaşdırma</h3>
          <p>AI rəqəmsal sistemin daxilində praktik bir qat kimi yerləşdirilir. Biz AI iş axınları, AI köməkçi əsaslı sistemlər və avtomatlaşdırılmış zəncirlər qururuq.</p>
          <ul class="clean-list mt-4">
            <li>Daxili iş axınları üçün AI köməkçiləri</li>
            <li>Sənəd və mətn emalı</li>
            <li>Bilik bazası sistemləri və xülasələşdirmə</li>
            <li>AI-dəstəkli maliyyə izləmə</li>
            <li>Agent əsaslı biznes sistemləri və n8n avtomatlaşdırması</li>
          </ul>
        </div>

        <!-- Area 5 -->
        <div class="focus-card reveal-el" style="transition-delay: 100ms;">
          <div class="focus-icon"><Icon name="lucide:layout-template" /></div>
          <h3>Məhsul və Platforma Təcrübəsi</h3>
          <p>Müxtəlif sahələr üzrə daxili məhsul işləri:</p>
          <ul class="clean-list mt-4">
            <li>Təhsil və elmi rəqəmsal sistemlər</li>
            <li>Astronomiya ilə bağlı platformalar</li>
            <li>QHT rəqəmsal transformasiyası</li>
            <li>Agent-aqnostik AI əsaslı əməliyyat sistemləri</li>
            <li>Marketinq üçün avtomatlaşdırılmış AI zəncirləri</li>
          </ul>
        </div>

        <!-- Area 6 -->
        <div class="focus-card reveal-el" style="transition-delay: 200ms;">
          <div class="focus-icon"><Icon name="lucide:shield-alert" /></div>
          <h3>Nələri vəd etmirik</h3>
          <p>Biz studiyanı bank-core tərtibatçısı, kibertəhlükəsizlik şirkəti, SAP/Oracle inteqratoru və ya yüksək yüklü müəssisə infrastruktur provayderi kimi təqdim etmirik.</p>
          <p class="mt-4">Mürəkkəb inteqrasiyalar, tənzimlənən fintech və ERP səviyyəli layihələr yalnız ciddi analizdən sonra xüsusi tapşırıq kimi qəbul edilir. Biz real və praktik yanaşırıq.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Main Value ── -->
  <section class="section section--philosophy">
    <div class="container container--narrow reveal-el">
      <div class="philosophy-content">
        <h2 class="section-title mb-8" style="text-align: center;">Müştərilər üçün əsas dəyər</h2>
        <ul class="value-list">
          <li><Icon name="lucide:arrow-right" class="value-icon" /> Biznes məntiqini işlək rəqəmsal sistemə çevirmək</li>
          <li><Icon name="lucide:arrow-right" class="value-icon" /> Mexaniki və ya nizamsız prosesləri strukturlaşdırılmış alətlərlə əvəz etmək</li>
          <li><Icon name="lucide:arrow-right" class="value-icon" /> Təşkilatla birlikdə böyüyə bilən saytlar və platformalar yaratmaq</li>
          <li><Icon name="lucide:arrow-right" class="value-icon" /> Məzmunu, istifadəçiləri, əməliyyatları və hesabatlılığı əlaqələndirmək</li>
          <li><Icon name="lucide:arrow-right" class="value-icon" /> AI-dan praktik fayda gətirdiyi yerdə istifadə etmək</li>
          <li><Icon name="lucide:arrow-right" class="value-icon" /> Anlaşılan və idarə oluna bilən sistemlər qurmaq</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Clients & Partners ── -->
  <section class="section">
    <div class="container">
      <div class="section-header reveal-el" style="text-align: center; margin: 0 auto var(--space-12);">
        <span class="section-tag" style="color: var(--division-ai);">Şəbəkə</span>
        <h2 class="section-title">Müştərilər və Tərəfdaşlar</h2>
      </div>
      
      <div class="clients-grid reveal-el">
        <div class="client-logo">
          <img src="/images/clients/ai/ai_client_1.png" alt="Müştəri 1" loading="lazy" />
        </div>
        <div class="client-logo">
          <img src="/images/clients/ai/ai_client_2.png" alt="Müştəri 2" loading="lazy" />
        </div>
        <div class="client-logo">
          <img src="/images/clients/ai/ai_client_3.png" alt="Müştəri 3" loading="lazy" />
        </div>
        <div class="client-logo">
          <img src="/images/clients/ai/ai_client_4.png" alt="Müştəri 4" loading="lazy" />
        </div>
        <div class="client-logo">
          <img src="/images/clients/ai/ai_client_5.png" alt="Müştəri 5" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- ── Selected Work ── -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header reveal-el">
        <span class="section-tag" style="color: var(--division-ai);">Portfoliо</span>
        <h2 class="section-title">Seçilmiş İşlər</h2>
      </div>
      
      {projects.length > 0 ? (
        <div class="grid grid--3">
          {projects.map((p: any, i: number) => (
            <a href={`/az/projects/${p.slug}`} class="project-card reveal-el" style={`transition-delay: ${i * 100}ms;`}>
              {p.cover ? (
                <div class="project-card__image">
                  <img src={p.cover} alt={p.title} loading="lazy" />
                </div>
              ) : (
                <div class="project-card__placeholder">
                  <Icon name="lucide:image" class="placeholder-icon" />
                </div>
              )}
              <div class="project-card__content">
                <div class="project-card__header">
                  <h3>{p.title}</h3>
                  {p.year && <span class="project-year">{p.year}</span>}
                </div>
                {p.client && <span class="project-client">{p.client}</span>}
                <p>{p.summary}</p>
                {p.tags && p.tags.length > 0 && (
                  <div class="project-tags">
                    {p.tags.slice(0, 3).map((tag: string) => (
                      <span class="project-tag">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="reveal-el">
          <p class="text-muted italic">Layihələr tezliklə əlavə olunacaq.</p>
        </div>
      )}
    </div>
  </section>

  <!-- ── Good Fit ── -->
  {d?.good_fit && d.good_fit.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="two-col-layout reveal-el">
          <div class="two-col-left">
            <span class="section-tag" style="color: var(--division-ai);">Uyğunluq</span>
            <h2 class="section-title">Nə zaman bizimlə işləmək düzgündür</h2>
            <p class="section-subtitle">Bu istiqamət aşağıdakı ehtiyacları olanlar üçün uyğundur:</p>
          </div>
          <div class="two-col-right">
            <ul class="fit-list">
              {d.good_fit.map((item: string, i: number) => (
                <li class="fit-item reveal-el" style={`transition-delay: ${i * 50}ms;`}>
                  <Icon name="lucide:check" class="fit-check" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ── Contact CTA ── -->
  <section class="section section--cta">
    <div class="container reveal-el">
      <div class="cta-card">
        <div class="cta-card__content">
          <span class="section-tag" style="color: rgba(255,255,255,0.7); margin-bottom: 1rem; display: block; text-align: center;">Əlaqə</span>
          <h2>{d?.cta_text || "Sisteminizi quraq"}</h2>
          <p>{d?.cta_supporting || "Hansı prosesi, məhsulu və ya sistemi qurmaq istədiyinizi bizə bildirin. Biz ideyanı strukturlaşdırmağa və onu praktik rəqəmsal həllə çevirməyə kömək edə bilərik."}</p>
          <a href="/az/contact" class="btn btn--primary btn--large" style="background: var(--division-ai);">
            Müzakirə edək
            <Icon name="lucide:arrow-right" class="icon" />
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
// Scroll reveal animation
const initReveal = () => {
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('reveal-active');
        observer.unobserve(entry.target);
      }
    });
  }, { rootMargin: '0px 0px -50px 0px', threshold: 0.1 });

  document.querySelectorAll('.reveal-el').forEach(el => {
    observer.observe(el);
  });
};

document.addEventListener('astro:page-load', initReveal);
initReveal();
</script>

<style>
  /* ── Hero Section ── */
  .hero {
    position: relative;
    padding: var(--space-32) 0 var(--space-24);
    color: var(--color-text-on-dark);
    overflow: hidden;
    min-height: 70vh;
    display: flex;
    align-items: center;
  }

  .hero-background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0.8) 100%);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 800px;
  }

  .hero-badge {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    background: var(--division-ai);
    color: #fff;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-6);
  }

  .hero-title {
    font-size: clamp(var(--text-4xl), 5vw, var(--text-6xl));
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-6);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .hero-subtitle {
    font-size: var(--text-xl);
    line-height: var(--leading-relaxed);
    color: rgba(255, 255, 255, 0.8);
    max-width: 700px;
  }

  /* ── Sections ── */
  .section {
    padding: var(--space-24) 0;
  }

  .section--alt {
    background: var(--color-bg-hover);
  }

  .section-header {
    margin-bottom: var(--space-16);
    max-width: 800px;
  }

  .section-tag {
    display: block;
    font-size: var(--text-xs);
    text-transform: uppercase;
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-2);
  }

  .section-title {
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-4);
  }

  .section-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  /* ── Philosophy ── */
  .section--philosophy {
    border-top: var(--border-thin);
    border-bottom: var(--border-thin);
    background: var(--color-bg-card);
  }

  .philosophy-content {
    padding: var(--space-10) 0;
  }

  .quote-icon {
    width: 48px;
    height: 48px;
    margin: 0 auto var(--space-6);
    display: block;
  }

  .philosophy-text {
    font-size: var(--text-2xl);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    font-weight: var(--weight-medium);
    text-align: center;
  }

  .prose-text p {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .value-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .value-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    padding: var(--space-4);
    background: var(--color-bg-hover);
    border-radius: var(--radius-md);
  }

  .value-icon {
    width: 24px;
    height: 24px;
    color: var(--division-ai);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .mt-8 { margin-top: var(--space-8); }
  .mt-4 { margin-top: var(--space-4); }
  .mb-8 { margin-bottom: var(--space-8); }

  /* ── Services Strip ── */
  .services-strip {
    padding: var(--space-8) 0;
    background: var(--color-bg);
    border-bottom: var(--border-thin);
  }

  .services-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
  }

  .service-tag {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    background: var(--color-bg-card);
    border: var(--border-thin);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    font-weight: var(--weight-medium);
  }

  /* ── Capabilities Grid ── */
  .capabilities-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 640px) {
    .capabilities-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .capabilities-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .capability-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--color-bg-card);
    border: var(--border-thin);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .cap-icon {
    width: 20px;
    height: 20px;
    color: var(--division-ai);
    flex-shrink: 0;
  }

  /* ── Focus Areas ── */
  .focus-areas {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  @media (min-width: 768px) {
    .focus-areas { grid-template-columns: repeat(2, 1fr); }
  }

  .focus-card {
    background: var(--color-bg-card);
    border: var(--border-thin);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
  }

  .focus-icon {
    width: 48px;
    height: 48px;
    background: color-mix(in srgb, var(--division-ai) 10%, var(--color-bg-card));
    color: var(--division-ai);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-6);
  }

  .focus-icon :global(svg) {
    width: 24px;
    height: 24px;
  }

  .focus-card h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
  }

  .focus-card p {
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  .clean-list {
    list-style: none;
    padding: 0;
    margin: 0;
