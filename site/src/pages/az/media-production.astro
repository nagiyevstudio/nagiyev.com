---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

const divisionEntries = await getCollection('divisions', ({ data, id }) => data.key === 'media-production' && id.startsWith('az/'));
const divisionEntry = divisionEntries[0];
const d = divisionEntry?.data;

const mediaProjects = await getCollection('projects', ({ data }) =>
  data.division === 'media-production'
);

const projects = mediaProjects.map((p) => ({
  slug: p.id,
  title: p.data.title,
  summary: p.data.summary,
  client: p.data.client,
  year: p.data.year,
  cover: p.data.cover,
  tags: p.data.tags,
}));
---

<BaseLayout title={d?.title || 'Media Production'} lang="az">
  <!-- ── Hero Section ── -->
  <section class="hero">
    <div class="hero-background">
      <img src={d?.cover || "/images/divisions/media-hero.jpg"} alt="Media Production Background" class="hero-bg-image" />
    </div>
    <div class="hero-overlay"></div>
    
    <div class="container">
      <div class="hero-content">
        <div class="hero-badge reveal-el">İstiqamət</div>
        <h1 class="hero-title reveal-el" style="transition-delay: 100ms;">
          {d?.title || "Media Production"}
        </h1>
        <p class="hero-subtitle reveal-el" style="transition-delay: 200ms;">
          {d?.subtitle || "Müasir brendlər üçün yüksək səviyyəli fotoqrafiya, video və kreativ istiqamət."}
        </p>
      </div>
    </div>
  </section>

  <!-- ── Main Positioning ── -->
  <section class="section">
    <div class="container container--narrow reveal-el">
      <div class="content-block" style="text-align: center;">
        <h2 class="section-title">Hekayənizi vizuallaşdıraq</h2>
        <p class="lead" style="font-size: var(--text-xl); line-height: var(--leading-relaxed); color: var(--color-text-secondary); margin-top: var(--space-6);">
          {d?.description || "Müasir brendlər üçün vizual hekayələr. Mesajınızı təsirli və üslubla çatdıran premium media aktivləri hazırlayırıq."}
        </p>
      </div>
    </div>
  </section>

  <!-- ── Services Strip ── -->
  {d?.services && d.services.length > 0 && (
    <section class="services-strip reveal-el">
      <div class="container">
        <div class="services-list">
          {d.services.map((s: string) => (
            <span class="service-tag">{s}</span>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── Capabilities ── -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header reveal-el">
        <span class="section-tag" style="color: var(--division-media);">İmkanlar</span>
        <h2 class="section-title">Nə təklif edirik</h2>
      </div>
      
      {d?.capabilities && (
        <div class="capabilities-grid reveal-el" style="transition-delay: 100ms;">
          {d.capabilities.map((cap: string) => (
            <div class="capability-item">
              <Icon name="lucide:check-circle-2" class="cap-icon" style="color: var(--division-media);" />
              <span>{cap}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- ── Selected Work ── -->
  <section class="section">
    <div class="container">
      <div class="section-header reveal-el">
        <span class="section-tag" style="color: var(--division-media);">Portfoliо</span>
        <h2 class="section-title">Seçilmiş İşlər</h2>
      </div>
      
      {projects.length > 0 ? (
        <div class="grid grid--3">
          {projects.map((p: any, i: number) => (
            <a href={`/az/projects/${p.slug}`} class="project-card reveal-el" style={`transition-delay: ${i * 100}ms;`}>
              {p.cover ? (
                <div class="project-card__image">
                  <img src={p.cover} alt={p.title} loading="lazy" />
                </div>
              ) : (
                <div class="project-card__placeholder">
                  <Icon name="lucide:image" class="placeholder-icon" />
                </div>
              )}
              <div class="project-card__content">
                <div class="project-card__header">
                  <h3>{p.title}</h3>
                  {p.year && <span class="project-year">{p.year}</span>}
                </div>
                {p.client && <span class="project-client" style="color: var(--division-media);">{p.client}</span>}
                <p>{p.summary}</p>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="reveal-el">
          <p class="text-muted italic">Layihələr tezliklə əlavə olunacaq.</p>
        </div>
      )}
    </div>
  </section>

  <!-- ── Contact CTA ── -->
  <section class="section section--cta">
    <div class="container reveal-el">
      <div class="cta-card">
        <div class="cta-card__content">
          <span class="section-tag" style="color: rgba(255,255,255,0.7); margin-bottom: 1rem; display: block; text-align: center;">Əlaqə</span>
          <h2>Hekayənizi bizimlə danışın</h2>
          <p>Kreativ fotoqrafiya, video istehsalı və ya media kampaniyası üçün bizimlə əlaqə saxlayın.</p>
          <a href="/az/contact" class="btn btn--primary btn--large" style="background: var(--division-media);">
            Müzakirə edək
            <Icon name="lucide:arrow-right" class="icon" />
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
// Scroll reveal animation
const initReveal = () => {
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('reveal-active');
        observer.unobserve(entry.target);
      }
    });
  }, { rootMargin: '0px 0px -50px 0px', threshold: 0.1 });

  document.querySelectorAll('.reveal-el').forEach(el => {
    observer.observe(el);
  });
};

document.addEventListener('astro:page-load', initReveal);
initReveal();
</script>

<style>
  /* ── Hero Section ── */
  .hero {
    position: relative;
    padding: var(--space-32) 0 var(--space-24);
    color: var(--color-text-on-dark);
    overflow: hidden;
    min-height: 70vh;
    display: flex;
    align-items: center;
  }

  .hero-background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0.8) 100%);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 800px;
  }

  .hero-badge {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    background: var(--division-media);
    color: #fff;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-6);
  }

  .hero-title {
    font-size: clamp(var(--text-4xl), 5vw, var(--text-6xl));
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-6);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .hero-subtitle {
    font-size: var(--text-xl);
    line-height: var(--leading-relaxed);
    color: rgba(255, 255, 255, 0.8);
    max-width: 700px;
  }

  /* ── Sections ── */
  .section {
    padding: var(--space-24) 0;
  }

  .section--alt {
    background: var(--color-bg-hover);
  }

  .section-header {
    margin-bottom: var(--space-16);
    max-width: 800px;
  }

  .section-tag {
    display: block;
    font-size: var(--text-xs);
    text-transform: uppercase;
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-2);
  }

  .section-title {
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-4);
  }

  /* ── Services Strip ── */
  .services-strip {
    padding: var(--space-8) 0;
    background: var(--color-bg);
    border-bottom: var(--border-thin);
  }

  .services-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
  }

  .service-tag {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    background: var(--color-bg-card);
    border: var(--border-thin);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    font-weight: var(--weight-medium);
  }

  /* ── Capabilities Grid ── */
  .capabilities-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 640px) {
    .capabilities-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .capabilities-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .capability-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--color-bg-card);
    border: var(--border-thin);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .cap-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  /* ── Project Cards ── */
  .grid--3 {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .grid--3 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid--3 { grid-template-columns: repeat(3, 1fr); } }

  .project-card {
    background: var(--color-bg-card);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: var(--border-thin);
    transition: all var(--transition-base);
    display: flex;
    flex-direction: column;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--division-media);
  }

  .project-card__image {
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .project-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .project-card:hover .project-card__image img {
    transform: scale(1.05);
  }

  .project-card__placeholder {
    aspect-ratio: 16/9;
    background: var(--color-bg-hover);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder-icon {
    width: 48px;
    height: 48px;
    color: var(--color-border);
  }

  .project-card__content {
    padding: var(--space-6);
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .project-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-2);
  }

  .project-card h3 {
    font-size: var(--text-xl);
    margin: 0;
  }

  .project-year {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-weight: var(--weight-medium);
  }

  .project-client {
    font-size: var(--text-xs);
    text-transform: uppercase;
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-3);
    display: block;
  }

  .project-card p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
    flex-grow: 1;
  }

  /* ── CTA Card ── */
  .cta-card {
    background: var(--color-bg-inverted);
    color: var(--color-text-on-dark);
    padding: var(--space-16) var(--space-10);
    border-radius: var(--radius-xl);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .cta-card h2 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
  }

  .cta-card p {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    margin: 0 auto var(--space-10);
    max-width: 600px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    font-weight: var(--weight-medium);
    transition: all var(--transition-base);
    cursor: pointer;
    text-decoration: none;
    color: var(--color-text-on-dark);
  }

  .btn--primary:hover {
    filter: brightness(1.2);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px -10px var(--division-media);
  }

  .btn--large {
    padding: var(--space-4) var(--space-10);
    font-size: var(--text-lg);
  }

  .btn .icon {
    width: 18px;
    height: 18px;
    transition: transform var(--transition-fast);
  }

  .btn:hover .icon {
    transform: translateX(3px);
  }

  /* ── Scroll Reveal ── */
  .reveal-el {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal-active {
    opacity: 1;
    transform: translateY(0);
  }
</style>
