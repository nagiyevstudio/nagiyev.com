---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

const featured = await getCollection('projects', ({ data, id }) => data.featured && id.startsWith('en/'));

const featuredProjects = featured.map((p: CollectionEntry<'projects'>) => ({
  slug: p.slug,
  title: p.data.title,
  summary: p.data.summary,
  division: p.data.division,
  cover: p.data.cover,
}));

const divisionsData = await getCollection('divisions', ({ id }) => id.startsWith('en/'));
const divisions = divisionsData.map((d: CollectionEntry<'divisions'>) => ({
  key: d.data.key,
  title: d.data.title,
  subtitle: d.data.subtitle,
}));
---

<script>
// Scroll reveal animation
const initReveal = () => {
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('reveal-active');
        observer.unobserve(entry.target);
      }
    });
  }, { rootMargin: '0px 0px -50px 0px', threshold: 0.1 });

  document.querySelectorAll('.section, .division-card, .project-card').forEach(el => {
    el.classList.add('reveal-el');
    observer.observe(el);
  });
};
initReveal();
</script>

<BaseLayout title="Nagiyev Studio" lang="en">
  <section class="hero">
    <div class="hero-background">
      <img src="/images/common/hero-bg.jpg" alt="" class="hero-bg-image" />
    </div>
    <div class="hero-overlay"></div>
    <div class="container">
      <h1 class="hero-title">Nagiyev Studio</h1>
      <p class="hero-subtitle">AI-powered digital systems, product design and media production for modern organizations.</p>
      <a href="#divisions" class="cta-button">Explore our work</a>
    </div>
  </section>

  <section id="divisions" class="section">
    <div class="container">
      <h2 class="section-title">Core Divisions</h2>
      <div class="grid grid--3">
        {divisions.map((d, i) => (
          <a href={`/${d.key}/`} class="division-card reveal-el">
            <div class="card-accent"></div>
            <h3>{d.title}</h3>
            <p>{d.subtitle}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Selected Work</h2>
      <div class="grid grid--3">
        {featuredProjects.map((p, i) => (
          <a href={`/projects/${p.slug}/`} class="project-card reveal-el">
            {p.cover && (
              <div class="project-cover">
                <img src={p.cover} alt={p.title} loading="lazy" />
              </div>
            )}
            {!p.cover && <div class="project-cover-placeholder"></div>}
            <div class="project-content">
              <h3>{p.title}</h3>
              <p class="project-summary">{p.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container container--narrow">
      <h2 class="section-title">Our Approach</h2>
      <p class="lead">We build complete digital ecosystems — not just websites or apps. Every project combines strategic thinking, technical excellence and design craft.</p>
    </div>
  </section>

  <section class="section cta-section">
    <div class="container">
      <h2 class="section-title">Discuss a project</h2>
      <div class="contact-links">
        <a href="https://wa.me/" class="contact-link">WhatsApp</a>
        <a href="https://t.me/" class="contact-link">Telegram</a>
        <a href="tel:+994" class="contact-link">Phone</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ── */
  
  .hero {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
    padding: var(--space-16) 0;
    overflow: hidden;
  }
  
  .hero-background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  
  .hero-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    z-index: 1;
  }
  
  .hero > .container {
    position: relative;
    z-index: 2;
  }
  
  .hero-title {
    font-size: clamp(var(--text-4xl), 8vw, var(--text-7xl));
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-6);
    color: #fff;
  }
  
  .hero-subtitle {
    font-size: clamp(var(--text-lg), 3vw, var(--text-2xl));
    color: rgba(255, 255, 255, 0.9);
    max-width: 60ch;
    margin-bottom: var(--space-8);
    line-height: var(--leading-relaxed);
  }
  
  .cta-button {
    display: inline-block;
    padding: var(--space-4) var(--space-8);
    background: var(--color-accent);
    color: #fff;
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    border-radius: var(--radius-md);
    transition: background var(--transition-fast), translate var(--transition-fast);
  }
  
  .cta-button:hover {
    background: var(--color-accent-hover);
    translate: 0 -2px;
  }
  
  /* ── Scroll Reveal ── */
  
  :root {
    --reveal-transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reveal-el {
    opacity: 0;
    transform: translateY(40px);
    transition: var(--reveal-transition);
  }
  
  .reveal-el.reveal-active {
    opacity: 1;
    transform: translateY(0);
  }
  
  /* ── Sections ── */
  
  .section {
    padding: var(--space-20) 0;
    border-bottom: var(--border-thin);
  }
  
  .section--alt {
    background: var(--color-bg-card);
  }
  
  .section-title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-10);
  }
  
  .lead {
    font-size: var(--text-xl);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }
  
  /* ── Division Cards ── */
  
  .division-card {
    position: relative;
    display: block;
    padding: var(--space-8);
    background: var(--color-bg-card);
    border: var(--border-thin);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--transition-fast), translate var(--transition-slow), box-shadow var(--transition-fast), var(--reveal-transition);
  }
  
  .card-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--division-ai) 0%, var(--division-design) 50%, var(--division-media) 100%);
    opacity: 0.5;
  }
  
  .division-card:hover {
    border-color: var(--color-text);
    translate: 0 -8px;
    box-shadow: var(--shadow-lg);
  }
  
  .division-card h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }
  
  .division-card p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
  }
  
  /* ── Project Cards ── */
  
  .project-card {
    position: relative;
    display: block;
    background: var(--color-bg-card);
    border: var(--border-thin);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--transition-fast), translate var(--transition-slow), box-shadow var(--transition-fast), var(--reveal-transition);
  }
  
  .project-card:hover {
    border-color: var(--color-text);
    translate: 0 -8px;
    box-shadow: var(--shadow-lg);
  }
  
  .project-cover {
    aspect-ratio: 16 / 9;
    background: var(--color-bg-hover);
    overflow: hidden;
  }
  
  .project-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }
  
  .project-card:hover .project-cover img {
    transform: scale(1.08);
  }
  
  .project-cover-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-bg-hover) 0%, var(--color-border-light) 100%);
  }
  
  .project-content {
    padding: var(--space-6);
  }
  
  .project-content h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }
  
  .project-summary {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }
  
  /* ── CTA Section ── */
  
  .cta-section {
    text-align: center;
  }
  
  .contact-links {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-6);
  }
  
  .contact-link {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    border: var(--border-thin);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    transition: background var(--transition-fast), border-color var(--transition-fast), translate var(--transition-fast);
  }
  
  .contact-link:hover {
    background: var(--color-text);
    border-color: var(--color-text);
    color: var(--color-text-on-dark);
    translate: 0 -2px;
  }
</style>
