---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

const divisionEntries = await getCollection('divisions', ({ data, id }) => data.key === 'media-production' && id.startsWith('en/'));
const divisionEntry = divisionEntries[0];
const d = divisionEntry?.data;

const mediaProjects = await getCollection('projects', ({ data, id }) =>
  data.division === 'media-production' && id.startsWith('en/')
);

const projects = mediaProjects.map((p) => ({
  slug: p.id.replace(/^en\//, ''),
  title: p.data.title,
  summary: p.data.summary,
  client: p.data.client,
  year: p.data.year,
  cover: p.data.cover,
  tags: p.data.tags,
}));
---

<BaseLayout title={d?.title || 'Media Production'} lang="en">
  <!-- ── Hero Section ── -->
  <section class="hero">
    <div class="hero-background">
      <img src={d?.cover || "/images/divisions/media-hero.jpg"} alt="Media Production Background" class="hero-bg-image" />
    </div>
    <div class="hero-overlay"></div>
    
    <div class="container">
      <div class="hero-content">
        <div class="hero-badge reveal-el">Division</div>
        <h1 class="hero-title reveal-el" style="transition-delay: 100ms;">
          {d?.hero_headline || "Photography, video and sound for serious visual communication."}
        </h1>
        <p class="hero-subtitle reveal-el" style="transition-delay: 200ms;">
          {d?.hero_supporting || "We create professional media content for businesses, institutions, events, cultural projects, science communication and public campaigns."}
        </p>
      </div>
    </div>
  </section>

  <!-- ── Main Positioning ── -->
  <section class="section section--philosophy">
    <div class="container container--narrow reveal-el">
      <div class="philosophy-content" style="display: flex; flex-direction: column; align-items: center; text-align: center;">
        <Icon name="lucide:aperture" class="quote-icon" style="color: var(--division-media);" />
        <p class="philosophy-text" style="max-width: 800px; margin: 0 auto;">
          Media is not just content for filling space. Good photography, video and sound shape how people perceive a business, city, product, event or organization.
        </p>
        <div class="prose-text mt-8" style="max-width: 700px; margin: 2rem auto 0 auto; font-size: var(--text-lg); color: var(--color-text-secondary); line-height: var(--leading-relaxed);">
          <p>This direction is built around high-quality visual and audio production that can be used across websites, presentations, books, exhibitions, social media, catalogues, campaigns and public communication.</p>
          <p style="margin-top: 1rem;"><strong>The strongest results come when media is planned as part of a larger brand, design or digital system.</strong></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Services Strip ── -->
  {d?.services && d.services.length > 0 && (
    <section class="services-strip reveal-el">
      <div class="container">
        <div class="services-list">
          {d.services.map((s: string) => (
            <span class="service-tag">{s}</span>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── Capabilities ── -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header reveal-el">
        <span class="section-tag" style="color: var(--division-media);">Scope</span>
        <h2 class="section-title">What This Direction Covers</h2>
        <p class="section-subtitle">From event, city, architecture, hospitality and product photography to scientific imagery, video content and professional sound production.</p>
      </div>
      
      {d?.capabilities && (
        <div class="capabilities-grid reveal-el" style="transition-delay: 100ms;">
          {d.capabilities.map((cap: string) => (
            <div class="capability-item">
              <Icon name="lucide:check-circle-2" class="cap-icon" />
              <span>{cap}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- ── Deep Dive: Focus Areas ── -->
  <section class="section">
    <div class="container">
      <div class="section-header reveal-el">
        <span class="section-tag" style="color: var(--division-media);">Focus Areas</span>
        <h2 class="section-title">Experience & Approach</h2>
      </div>

      <div class="focus-areas">
        <div class="focus-card reveal-el">
          <div class="focus-icon"><Icon name="lucide:camera" /></div>
          <h3>Photography</h3>
          <p>Photography is one of the strongest parts of this direction. The experience covers event photography, international and institutional event coverage, city and urban photography, parks, boulevards and public spaces, architecture, interior and exterior, hospitality and hotel photography, product, cultural, scientific, astrophotography, industrial photography, and photography for websites, catalogues, books, exhibitions and public campaigns.</p>
        </div>

        <div class="focus-card reveal-el" style="transition-delay: 100ms;">
          <div class="focus-icon"><Icon name="lucide:building-2" /></div>
          <h3>City, Architecture & Hospitality</h3>
          <p>Strong experience in city, architecture, interior and exterior photography — city commissions, public spaces, architectural structures, hotels, hospitality complexes, boutique hotels, interiors, exteriors, and visual content for travel, booking and presentation platforms.</p>
          <p class="mt-4">Especially relevant for hotels, developers, tourism projects, city projects and public institutions.</p>
        </div>

        <div class="focus-card reveal-el" style="transition-delay: 200ms;">
          <div class="focus-icon"><Icon name="lucide:package" /></div>
          <h3>Product & Brand Visuals</h3>
          <p>Product and brand photography as part of business communication: product visuals, premium and rare product photography, catalogue photography, campaign visuals, website visuals, presentation materials, social media content, and visual assets for brand communication.</p>
          <p class="mt-4">The goal is not only to show the product, but to present it with the right level of quality, context and trust.</p>
        </div>

        <div class="focus-card reveal-el">
          <div class="focus-icon"><Icon name="lucide:telescope" /></div>
          <h3>Scientific & Astrophotography</h3>
          <p>Scientific and astronomy-related visuals are a distinctive part of this direction: professional astrophotography, scientific visual materials, astronomy exhibitions, educational science visuals, and public science communication.</p>
          <p class="mt-4">Especially useful for projects where visual material must explain, inspire or make complex subjects accessible to a broad audience.</p>
        </div>

        <div class="focus-card reveal-el" style="transition-delay: 100ms;">
          <div class="focus-icon"><Icon name="lucide:factory" /></div>
          <h3>Industrial Photography</h3>
          <p>Industrial photography for production environments: industrial facilities, manufacturing processes, production lines, technical environments, process documentation, corporate reporting visuals, management-level presentation materials, and investment and business communication materials.</p>
        </div>

        <div class="focus-card reveal-el" style="transition-delay: 200ms;">
          <div class="focus-icon"><Icon name="lucide:video" /></div>
          <h3>Video Production</h3>
          <p>Video production is handled through the studio's production network and can include concept, shooting, editing, visual direction, interview formats, promotional content and event coverage.</p>
          <ul class="clean-list mt-4">
            <li>Event video & conference coverage</li>
            <li>Interviews & promotional videos</li>
            <li>Educational & scientific sequences</li>
            <li>Video for websites & social media</li>
            <li>Campaign & presentation materials</li>
          </ul>
        </div>

        <div class="focus-card reveal-el">
          <div class="focus-icon"><Icon name="lucide:music" /></div>
          <h3>Sound, Music & Audio</h3>
          <p>Sound is a major strength of this direction — not an add-on to video, but a serious professional background that can support brand communication, media content, campaigns, events and digital products.</p>
          <ul class="clean-list mt-4">
            <li>Sound design & music composition</li>
            <li>Corporate soundtracks & jingles</li>
            <li>Audio editing, mixing & mastering</li>
            <li>Recording studio & label experience</li>
            <li>Intro & identity audio</li>
          </ul>
        </div>

        <div class="focus-card reveal-el" style="transition-delay: 100ms;">
          <div class="focus-icon"><Icon name="lucide:compass" /></div>
          <h3>Creative Direction</h3>
          <p>The studio can think through the whole media package, not only produce isolated assets: concept, idea development, scenario, visual style, photography and video direction, content structure, editing supervision, sound direction, and packaging for websites, social media, presentations and campaigns.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Main Value ── -->
  <section class="section section--philosophy">
    <div class="container container--narrow reveal-el">
      <div class="philosophy-content">
        <h2 class="section-title mb-8" style="text-align: center;">Main Value for Clients</h2>
        <ul class="value-list">
          <li><Icon name="lucide:arrow-right" class="value-icon" /> Creating serious visual material for public use</li>
          <li><Icon name="lucide:arrow-right" class="value-icon" /> Presenting a business, product, event or institution at a higher level</li>
          <li><Icon name="lucide:arrow-right" class="value-icon" /> Producing media that works across websites, catalogues, books, presentations and campaigns</li>
          <li><Icon name="lucide:arrow-right" class="value-icon" /> Combining visual and audio production in one creative direction</li>
          <li><Icon name="lucide:arrow-right" class="value-icon" /> Handling complex topics: culture, science, industry, public communication</li>
          <li><Icon name="lucide:arrow-right" class="value-icon" /> Connecting media production with design, digital systems and business presentation</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Clients & Partners ── -->
  <section class="section">
    <div class="container">
      <div class="section-header reveal-el" style="text-align: center; margin: 0 auto var(--space-12);">
        <span class="section-tag" style="color: var(--division-media);">Network</span>
        <h2 class="section-title">Clients & Partners</h2>
      </div>
      
      <div class="clients-grid reveal-el">
        <div class="client-logo">
          <img src="/images/clients/media/media_client_1.png" alt="Client 1" loading="lazy" />
        </div>
        <div class="client-logo">
          <img src="/images/clients/media/media_client_2.png" alt="Client 2" loading="lazy" />
        </div>
        <div class="client-logo">
          <img src="/images/clients/media/media_client_3.png" alt="Client 3" loading="lazy" />
        </div>
        <div class="client-logo">
          <img src="/images/clients/media/media_client_4.png" alt="Client 4" loading="lazy" />
        </div>
        <div class="client-logo">
          <img src="/images/clients/media/media_client_5.png" alt="Client 5" loading="lazy" />
        </div>
        <div class="client-logo">
          <img src="/images/clients/media/media_client_6.png" alt="Client 6" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- ── Selected Work ── -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header reveal-el">
        <span class="section-tag" style="color: var(--division-media);">Case Studies</span>
        <h2 class="section-title">Selected Media Work</h2>
      </div>
      
      {projects.length > 0 ? (
        <div class="grid grid--3">
          {projects.map((p: any, i: number) => (
            <a href={`/projects/${p.slug}`} class="project-card reveal-el" style={`transition-delay: ${i * 100}ms;`}>
              {p.cover ? (
                <div class="project-card__image">
                  <img src={p.cover} alt={p.title} loading="lazy" />
                </div>
              ) : (
                <div class="project-card__placeholder">
                  <Icon name="lucide:image" class="placeholder-icon" />
                </div>
              )}
              <div class="project-card__content">
                <div class="project-card__header">
                  <h3>{p.title}</h3>
                  {p.year && <span class="project-year">{p.year}</span>}
                </div>
                {p.client && <span class="project-client">{p.client}</span>}
                <p>{p.summary}</p>
                {p.tags && p.tags.length > 0 && (
                  <div class="project-tags">
                    {p.tags.slice(0, 3).map((tag: string) => (
                      <span class="project-tag">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="reveal-el">
          <p class="text-muted italic">Case studies coming soon.</p>
        </div>
      )}
    </div>
  </section>

  <!-- ── Good Fit ── -->
  {d?.good_fit && d.good_fit.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="two-col-layout reveal-el">
          <div class="two-col-left">
            <span class="section-tag" style="color: var(--division-media);">Fit</span>
            <h2 class="section-title">When this is a good fit</h2>
            <p class="section-subtitle">This direction is suitable for clients who need:</p>
          </div>
          <div class="two-col-right">
            <ul class="fit-list">
              {d.good_fit.map((item: string, i: number) => (
                <li class="fit-item reveal-el" style={`transition-delay: ${i * 50}ms;`}>
                  <Icon name="lucide:check" class="fit-check" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ── Contact CTA ── -->
  <section class="section section--cta">
    <div class="container reveal-el">
      <div class="cta-card">
        <div class="cta-card__content">
          <span class="section-tag" style="color: rgba(255,255,255,0.7); margin-bottom: 1rem; display: block; text-align: center;">Contact</span>
          <h2>{d?.cta_text || "Contact us"}</h2>
          <p>{d?.cta_supporting || "Tell us what you need to present: a business, event, product, place, publication or public idea. We can help create the visual and audio content around it."}</p>
          <a href="/contact" class="btn btn--primary btn--large" style="background: var(--division-media);">
            Get in touch
            <Icon name="lucide:arrow-right" class="icon" />
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
const initReveal = () => {
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('reveal-active');
        observer.unobserve(entry.target);
      }
    });
  }, { rootMargin: '0px 0px -50px 0px', threshold: 0.1 });

  document.querySelectorAll('.reveal-el').forEach(el => {
    observer.observe(el);
  });
};

document.addEventListener('astro:page-load', initReveal);
initReveal();
</script>

<style>
  /* ── Hero Section ── */
  .hero {
    position: relative;
    padding: var(--space-32) 0 var(--space-24);
    color: var(--color-text-on-dark);
    overflow: hidden;
    min-height: 70vh;
    display: flex;
    align-items: center;
  }
  .hero-background { position: absolute; inset: 0; z-index: 0; }
  .hero-bg-image { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.8) 100%);
    z-index: 1;
  }
  .hero-content { position: relative; z-index: 2; max-width: 800px; }
  .hero-badge {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    background: var(--division-media);
    color: #fff;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-6);
  }
  .hero-title {
    font-size: clamp(var(--text-4xl), 5vw, var(--text-6xl));
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-6);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }
  .hero-subtitle {
    font-size: var(--text-xl);
    line-height: var(--leading-relaxed);
    color: rgba(255,255,255,0.8);
    max-width: 700px;
  }

  /* ── Sections ── */
  .section { padding: var(--space-24) 0; }
  .section--alt { background: var(--color-bg-hover); }
  .section-header { margin-bottom: var(--space-16); max-width: 800px; }
  .section-tag {
    display: block; font-size: var(--text-xs); text-transform: uppercase;
    font-weight: var(--weight-bold); letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-2);
  }
  .section-title { font-size: var(--text-4xl); font-weight: var(--weight-bold); margin-bottom: var(--space-4); }
  .section-subtitle { font-size: var(--text-lg); color: var(--color-text-secondary); line-height: var(--leading-relaxed); }

  /* ── Philosophy ── */
  .section--philosophy { border-top: var(--border-thin); border-bottom: var(--border-thin); background: var(--color-bg-card); }
  .philosophy-content { padding: var(--space-10) 0; }
  .quote-icon { width: 48px; height: 48px; margin: 0 auto var(--space-6); display: block; }
  .philosophy-text {
    font-size: var(--text-2xl); line-height: var(--leading-relaxed);
    color: var(--color-text); font-weight: var(--weight-medium); text-align: center;
  }
  .prose-text p { font-size: var(--text-lg); color: var(--color-text-secondary); line-height: var(--leading-relaxed); margin-bottom: var(--space-4); }
  .value-list { display: flex; flex-direction: column; gap: var(--space-4); }
  .value-list li {
    display: flex; align-items: flex-start; gap: var(--space-4);
    font-size: var(--text-lg); color: var(--color-text-secondary);
    line-height: var(--leading-relaxed); padding: var(--space-4);
    background: var(--color-bg-hover); border-radius: var(--radius-md);
  }
  .value-icon { width: 24px; height: 24px; color: var(--division-media); flex-shrink: 0; margin-top: 2px; }
  .mt-8 { margin-top: var(--space-8); }
  .mt-4 { margin-top: var(--space-4); }
  .mb-8 { margin-bottom: var(--space-8); }

  /* ── Services Strip ── */
  .services-strip { padding: var(--space-8) 0; background: var(--color-bg); border-bottom: var(--border-thin); }
  .services-list { display: flex; flex-wrap: wrap; gap: var(--space-3); justify-content: center; }
  .service-tag {
    display: inline-block; padding: var(--space-2) var(--space-4);
    background: var(--color-bg-card); border: var(--border-thin);
    border-radius: var(--radius-full); font-size: var(--text-sm);
    color: var(--color-text-secondary); font-weight: var(--weight-medium);
  }

  /* ── Capabilities Grid ── */
  .capabilities-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-4); }
  @media (min-width: 640px) { .capabilities-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .capabilities-grid { grid-template-columns: repeat(3, 1fr); } }
  .capability-item {
    display: flex; align-items: center; gap: var(--space-3);
    padding: var(--space-4); background: var(--color-bg-card);
    border: var(--border-thin); border-radius: var(--radius-md);
    font-size: var(--text-sm); font-weight: var(--weight-medium);
  }
  .cap-icon { width: 20px; height: 20px; color: var(--division-media); flex-shrink: 0; }

  /* ── Focus Areas ── */
  .focus-areas { display: grid; grid-template-columns: 1fr; gap: var(--space-6); }
  @media (min-width: 768px) { .focus-areas { grid-template-columns: repeat(2, 1fr); } }
  .focus-card { background: var(--color-bg-card); border: var(--border-thin); padding: var(--space-8); border-radius: var(--radius-lg); }
  .focus-icon {
    width: 48px; height: 48px;
    background: color-mix(in srgb, var(--division-media) 10%, var(--color-bg-card));
    color: var(--division-media); border-radius: var(--radius-md);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: var(--space-6);
  }
  .focus-icon :global(svg) { width: 24px; height: 24px; }
  .focus-card h3 { font-size: var(--text-xl); margin-bottom: var(--space-4); }
  .focus-card p { color: var(--color-text-secondary); font-size: var(--text-base); line-height: var(--leading-relaxed); }
  .clean-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .clean-list li { position: relative; padding-left: var(--space-4); color: var(--color-text-secondary); font-size: var(--text-sm); }
  .clean-list li::before {
    content: ''; position: absolute; left: 0; top: 8px;
    width: 4px; height: 4px; border-radius: 50%; background: var(--division-media);
  }

  /* ── Selected Work Cards ── */
  .grid--3 { display: grid; gap: var(--space-6); grid-template-columns: 1fr; }
  @media (min-width: 640px) { .grid--3 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid--3 { grid-template-columns: repeat(3, 1fr); } }
  .project-card {
    background: var(--color-bg-card); border-radius: var(--radius-lg);
    overflow: hidden; border: var(--border-thin);
    transition: all var(--transition-base); display: flex; flex-direction: column;
  }
  .project-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: var(--division-media); }
  .project-card__image { aspect-ratio: 16/9; overflow: hidden; }
  .project-card__image img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--transition-slow); }
  .project-card:hover .project-card__image img { transform: scale(1.05); }
  .project-card__placeholder { aspect-ratio: 16/9; background: var(--color-bg-hover); display: flex; align-items: center; justify-content: center; }
  .placeholder-icon { width: 48px; height: 48px; color: var(--color-border); }
  .project-card__content { padding: var(--space-6); flex-grow: 1; display: flex; flex-direction: column; }
  .project-card__header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--space-2); }
  .project-card h3 { font-size: var(--text-xl); margin: 0; }
  .project-year { font-size: var(--text-xs); color: var(--color-text-muted); font-weight: var(--weight-medium); }
  .project-client { font-size: var(--text-xs); text-transform: uppercase; color: var(--division-media); font-weight: var(--weight-bold); margin-bottom: var(--space-3); display: block; }
  .project-card p { font-size: var(--text-sm); color: var(--color-text-secondary); margin-bottom: var(--space-4); flex-grow: 1; }
  .project-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: auto; }
  .project-tag { font-size: var(--text-xs); padding: 2px var(--space-2); background: var(--color-bg-hover); color: var(--color-text-secondary); border-radius: var(--radius-sm); }

  /* ── Two Column (Good Fit) ── */
  .two-col-layout { display: grid; grid-template-columns: 1fr; gap: var(--space-12); }
  @media (min-width: 768px) { .two-col-layout { grid-template-columns: 1fr 1fr; } }
  .fit-list { display: flex; flex-direction: column; gap: var(--space-4); }
  .fit-item {
    display: flex; align-items: flex-start; gap: var(--space-4);
    padding: var(--space-4); background: var(--color-bg-card);
    border: var(--border-thin); border-radius: var(--radius-md);
  }
  .fit-check { width: 24px; height: 24px; color: var(--division-media); flex-shrink: 0; }
  .fit-item span { font-size: var(--text-base); color: var(--color-text); line-height: var(--leading-snug); }

  /* ── CTA Card ── */
  .cta-card {
    background: var(--color-bg-inverted); color: var(--color-text-on-dark);
    padding: var(--space-16) var(--space-10); border-radius: var(--radius-xl);
    text-align: center; position: relative; overflow: hidden;
  }
  .cta-card h2 { font-size: var(--text-4xl); margin-bottom: var(--space-4); }
