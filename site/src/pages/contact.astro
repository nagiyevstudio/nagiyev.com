---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
---

<BaseLayout
  title="Contact — Nagiyev Studio"
  description="Get in touch with Nagiyev Studio. We're available via WhatsApp, Telegram and phone."
  lang="en"
>
  <section class="contact-page">
    <div class="container contact-container">

      <!-- Header -->
      <div class="contact-header reveal-el">
        <span class="section-tag">Get in touch</span>
        <h1 class="contact-title">Let's talk about<br />your project.</h1>
        <p class="contact-lead">
          Whether you have a clear brief or just an idea — reach out directly.
          We respond quickly and prefer real conversations over forms.
        </p>
      </div>

      <!-- Contact Methods -->
      <div class="contact-methods">

        <a
          href="https://wa.me/994503222142"
          target="_blank"
          rel="noopener noreferrer"
          class="method-card reveal-el"
          style="transition-delay: 100ms;"
          id="contact-whatsapp"
        >
          <div class="method-icon method-icon--whatsapp">
            <Icon name="lucide:message-circle" />
          </div>
          <div class="method-body">
            <span class="method-label">WhatsApp</span>
            <span class="method-value">+994 50 322 21 42</span>
            <span class="method-hint">Fastest response</span>
          </div>
          <Icon name="lucide:arrow-up-right" class="method-arrow" />
        </a>

        <a
          href="https://t.me/nagiyevstudio"
          target="_blank"
          rel="noopener noreferrer"
          class="method-card reveal-el"
          style="transition-delay: 200ms;"
          id="contact-telegram"
        >
          <div class="method-icon method-icon--telegram">
            <Icon name="lucide:send" />
          </div>
          <div class="method-body">
            <span class="method-label">Telegram</span>
            <span class="method-value">@faiknagiyev</span>
            <span class="method-hint">Available 9:00 – 22:00</span>
          </div>
          <Icon name="lucide:arrow-up-right" class="method-arrow" />
        </a>

        <a
          href="tel:+994503222142"
          class="method-card reveal-el"
          style="transition-delay: 300ms;"
          id="contact-phone"
        >
          <div class="method-icon method-icon--phone">
            <Icon name="lucide:phone" />
          </div>
          <div class="method-body">
            <span class="method-label">Phone</span>
            <span class="method-value">+994 50 322 21 42</span>
            <span class="method-hint">Baku, Azerbaijan (GMT+4)</span>
          </div>
          <Icon name="lucide:arrow-up-right" class="method-arrow" />
        </a>

      </div>

      <!-- Bottom note -->
      <p class="contact-note reveal-el" style="transition-delay: 400ms;">
        Nagiyev Studio works with clients across Azerbaijan and internationally.
        All conversations are confidential.
      </p>

    </div>
  </section>
</BaseLayout>

<script>
  const initReveal = () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('reveal-active');
          observer.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -40px 0px', threshold: 0.1 });
    document.querySelectorAll('.reveal-el').forEach(el => observer.observe(el));
  };
  document.addEventListener('astro:page-load', initReveal);
  initReveal();
</script>

<style>
  /* ── Layout ── */
  .contact-page {
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    padding: var(--space-24) 0 var(--space-32);
  }

  .contact-container {
    width: 100%;
    max-width: 720px;
  }

  /* ── Header ── */
  .section-tag {
    display: block;
    font-size: var(--text-xs);
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-4);
  }

  .contact-title {
    font-size: clamp(var(--text-4xl), 6vw, var(--text-6xl));
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin-bottom: var(--space-6);
  }

  .contact-lead {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    max-width: 52ch;
    margin-bottom: var(--space-16);
  }

  /* ── Contact Methods ── */
  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-12);
  }

  .method-card {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-5) var(--space-6);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.2s ease,
      box-shadow 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .method-card::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .method-card--whatsapp::before { background: linear-gradient(135deg, rgba(37,211,102,0.04) 0%, transparent 60%); }
  .method-card--telegram::before { background: linear-gradient(135deg, rgba(36,161,222,0.04) 0%, transparent 60%); }
  .method-card--phone::before    { background: linear-gradient(135deg, rgba(0,85,255,0.04) 0%, transparent 60%); }

  .method-card:hover {
    transform: translateX(6px);
    border-color: var(--color-text);
    box-shadow: var(--shadow-md);
  }

  .method-card:hover::before {
    opacity: 1;
  }

  /* ── Icon ── */
  .method-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .method-icon :global(svg) {
    width: 22px;
    height: 22px;
  }

  .method-icon--whatsapp {
    background: rgba(37, 211, 102, 0.1);
    color: #25d366;
  }

  .method-icon--telegram {
    background: rgba(36, 161, 222, 0.1);
    color: #24a1de;
  }

  .method-icon--phone {
    background: rgba(0, 85, 255, 0.08);
    color: var(--color-accent);
  }

  /* ── Body text ── */
  .method-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }

  .method-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
    font-weight: var(--weight-semibold);
  }

  .method-value {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    letter-spacing: var(--tracking-tight);
  }

  .method-hint {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* ── Arrow ── */
  .method-arrow {
    width: 18px;
    height: 18px;
    color: var(--color-text-muted);
    flex-shrink: 0;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .method-card:hover .method-arrow {
    color: var(--color-text);
    transform: translate(2px, -2px);
  }

  /* ── Bottom note ── */
  .contact-note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: 50ch;
    border-top: var(--border-thin);
    padding-top: var(--space-8);
    line-height: var(--leading-relaxed);
  }

  /* ── Scroll Reveal ── */
  .reveal-el {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reveal-active {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Mobile ── */
  @media (max-width: 640px) {
    .contact-page {
      padding: var(--space-16) 0 var(--space-24);
      align-items: flex-start;
    }

    .method-value {
      font-size: var(--text-base);
    }

    .method-card:hover {
      transform: none;
    }
  }
</style>
