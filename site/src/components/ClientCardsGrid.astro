---
import { getCollection, render } from 'astro:content';
import ClientCard from './ClientCard.astro';
import { Icon } from 'astro-icon/components';

export interface Props {
  division: 'digital-systems-ai' | 'product-design' | 'media-production';
  lang: 'en' | 'az';
}

const { division, lang } = Astro.props;

// Fetch and filter clients matching the current language and division
const clientsData = await getCollection('clients', ({ id, data }) => {
  const matchesLang = id.startsWith(`${lang}/`);
  const matchesDivision = data.divisions && data.divisions.includes(division);
  return matchesLang && matchesDivision;
});

// Sort by order ascending
const sortedClients = clientsData.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

// Render helper for Content
const clientsWithContent = await Promise.all(
  sortedClients.map(async (client) => {
    const { Content } = await render(client);
    return { client, Content };
  })
);
---

{clientsWithContent.length > 0 && (
  <div class="client-cards-section">
    <div class="grid grid--3">
      {clientsWithContent.map(({ client, Content }) => (
        <ClientCard client={client} lang={lang}>
          <Content />
        </ClientCard>
      ))}
    </div>

    <!-- Global Detailed Client Modal -->
    <div class="client-modal" id="clientDetailsModal" aria-hidden="true" role="dialog">
      <div class="client-modal__overlay" id="clientModalOverlay"></div>
      <div class="client-modal__container">
        <button class="client-modal__close" id="clientModalClose" aria-label="Close modal">
          <Icon name="lucide:x" class="icon" />
        </button>
        <div class="client-modal__content" id="clientModalContent">
          <!-- Populated dynamically via JS -->
        </div>
      </div>
    </div>
  </div>
)}

<script>
  const initClientModal = () => {
    const modal = document.getElementById('clientDetailsModal');
    const overlay = document.getElementById('clientModalOverlay');
    const closeBtn = document.getElementById('clientModalClose');
    const modalContent = document.getElementById('clientModalContent');
    const openButtons = document.querySelectorAll('.js-open-client-details');

    if (!modal || !overlay || !closeBtn || !modalContent) return;

    const openModal = (cardEl: HTMLElement) => {
      const hiddenContent = cardEl.querySelector('.client-card__details-hidden');
      if (!hiddenContent) return;

      // Populate content
      modalContent.innerHTML = hiddenContent.innerHTML;
      
      // Show modal with animation
      modal.setAttribute('aria-hidden', 'false');
      modal.classList.add('client-modal--active');
      document.body.style.overflow = 'hidden'; // Prevent body scroll
    };

    const closeModal = () => {
      modal.classList.remove('client-modal--active');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = ''; // Restore scroll

      // Wait for exit transition, then clear content
      setTimeout(() => {
        if (!modal.classList.contains('client-modal--active')) {
          modalContent.innerHTML = '';
        }
      }, 300); // Matches CSS transition duration
    };

    // Attach click events to open buttons
    openButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const cardId = btn.getAttribute('data-client-id');
        const cardEl = document.querySelector(`.client-card[data-client-id="${cardId}"]`) as HTMLElement;
        if (cardEl) {
          openModal(cardEl);
        }
      });
    });

    // Close on overlay click
    overlay.addEventListener('click', closeModal);

    // Close on button click
    closeBtn.addEventListener('click', closeModal);

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('client-modal--active')) {
        closeModal();
      }
    });
  };

  // Re-run on Astro page transitions
  document.addEventListener('astro:page-load', initClientModal);
  initClientModal();
</script>

<style is:global>
  /* Global modal styles linked to our layout */
  .client-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-slow);
  }

  .client-modal--active {
    opacity: 1;
    pointer-events: auto;
  }

  .client-modal__overlay {
    position: absolute;
    inset: 0;
    background: rgba(28, 25, 23, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: all var(--transition-slow);
  }

  .client-modal__container {
    position: relative;
    width: 100%;
    max-width: var(--container-md);
    background: var(--color-bg-card);
    border: 1px solid rgba(28, 25, 23, 0.1);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    z-index: 101;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    transform: scale(0.95) translateY(10px);
    transition: transform var(--transition-slow) cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
  }

  .client-modal--active .client-modal__container {
    transform: scale(1) translateY(0);
  }

  .client-modal__close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    background: var(--color-bg-hover);
    border: 1px solid rgba(28, 25, 23, 0.05);
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
    transition: all var(--transition-fast);
    z-index: 10;
  }

  .client-modal__close:hover {
    color: var(--color-text);
    background: var(--color-border);
    transform: rotate(90deg);
  }

  .client-modal__close .icon {
    width: 18px;
    height: 18px;
  }

  .client-modal__content {
    padding: var(--space-8);
    overflow-y: auto;
    flex-grow: 1;
  }

  /* Modal Interior Layout */
  .details-modal-header {
    margin-bottom: var(--space-6);
    border-bottom: 1px solid rgba(28, 25, 23, 0.08);
    padding-bottom: var(--space-6);
    position: relative;
  }

  .modal-header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
    padding-right: var(--space-12);
  }

  .modal-divisions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .badge-division {
    font-size: 11px;
    font-family: var(--font-mono);
    font-weight: var(--weight-semibold);
    padding: 4px 10px;
    border-radius: var(--radius-full);
    display: inline-flex;
    align-items: center;
  }

  .badge-division--digital-systems-ai {
    background: rgba(37, 99, 235, 0.08);
    color: var(--division-ai);
    border: 1px solid rgba(37, 99, 235, 0.15);
  }

  .badge-division--product-design {
    background: rgba(217, 119, 6, 0.08);
    color: var(--division-design);
    border: 1px solid rgba(217, 119, 6, 0.15);
  }

  .badge-division--media-production {
    background: rgba(124, 58, 237, 0.08);
    color: var(--division-media);
    border: 1px solid rgba(124, 58, 237, 0.15);
  }

  .modal-logo-wrapper {
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .modal-logo {
    max-height: 48px;
    width: auto;
    object-fit: contain;
  }

  .modal-title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }

  .modal-subtitle {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
  }

  /* Details body containing markdown */
  .details-modal-body {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    margin-bottom: var(--space-6);
  }

  .details-modal-body p {
    margin-bottom: var(--space-4);
    color: var(--color-text-secondary);
    max-width: 100%;
  }

  .details-modal-body ul {
    list-style: none;
    padding-left: 0;
    margin-bottom: var(--space-4);
  }

  .details-modal-body li {
    position: relative;
    padding-left: var(--space-6);
    margin-bottom: var(--space-2);
    color: var(--color-text);
  }

  .details-modal-body li::before {
    content: "•";
    position: absolute;
    left: var(--space-1);
    top: 0;
    color: var(--color-accent);
    font-size: 1.3em;
    line-height: 1;
  }

  /* Modal Footer */
  .details-modal-footer {
    border-top: 1px solid rgba(28, 25, 23, 0.08);
    padding-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .modal-tech h4 {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .modal-case-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  @media (max-width: 640px) {
    .client-modal {
      padding: 0;
      align-items: flex-end;
    }
    
    .client-modal__container {
      max-height: 85vh;
      border-radius: var(--radius-xl) var(--radius-xl) 0 0;
      transform: scale(1) translateY(100%);
    }

    .client-modal--active .client-modal__container {
      transform: scale(1) translateY(0);
    }
    
    .client-modal__content {
      padding: var(--space-6);
    }
  }
</style>
