---
import { Icon } from 'astro-icon/components';

export interface Props {
  client: any;
  lang: 'en' | 'az';
}

const { client, lang } = Astro.props;
const { name, logo, divisions, industry, format, tech, projectSlug } = client.data;

// Parse the first few sentences from body for the card summary
const summaryText = client.body
  ? client.body.split('\n')[0].replace(/^[#-*_>\s]+/, '')
  : '';

// Translations helper
const t = {
  en: {
    moreInfo: 'More Info',
    readCase: 'Read Case Study',
    techTitle: 'Technologies & Tools',
    'digital-systems-ai': 'Digital Systems & AI',
    'product-design': 'Product & Design',
    'media-production': 'Media Production'
  },
  az: {
    moreInfo: 'Ətraflı',
    readCase: 'Keysi oxu',
    techTitle: 'Texnologiyalar və Alətlər',
    'digital-systems-ai': 'Rəqəmsal Sistemlər və AI',
    'product-design': 'Məhsul və Dizayn',
    'media-production': 'Media İstehsalı'
  }
}[lang];
---

<div class="client-card reveal-el" data-client-id={client.id}>
  <!-- Multi-disciplinary Indicator Dots -->
  <div class="client-card__dots">
    {divisions.map((div: string) => {
      const colorVar = div === 'digital-systems-ai' ? 'var(--division-ai)' :
                       div === 'product-design' ? 'var(--division-design)' :
                       'var(--division-media)';
      const titleText = t[div];
      return (
        <span 
          class={`dot dot--${div}`} 
          style={`background-color: ${colorVar};`}
          title={titleText}
        ></span>
      );
    })}
  </div>

  <!-- Logo Container -->
  <div class="client-card__logo-wrapper">
    <img src={logo} alt={name} class="client-card__logo" loading="lazy" />
  </div>

  <!-- Card Body -->
  <div class="client-card__content">
    <div class="client-card__meta">
      <span class="client-card__industry">{industry}</span>
      <span class="client-card__format">{format}</span>
    </div>
    
    <h3 class="client-card__name">{name}</h3>
    <p class="client-card__summary">{summaryText}</p>
    
    {tech && tech.length > 0 && (
      <div class="client-card__tech">
        {tech.slice(0, 3).map((item: string) => (
          <span class="tech-badge">{item}</span>
        ))}
        {tech.length > 3 && (
          <span class="tech-badge tech-badge--more">+{tech.length - 3}</span>
        )}
      </div>
    )}
  </div>

  <!-- Card Footer -->
  <div class="client-card__footer">
    <button class="btn-more js-open-client-details" data-client-id={client.id}>
      <span>{t.moreInfo}</span>
      <Icon name="lucide:arrow-up-right" class="icon" />
    </button>
  </div>

  <!-- Hidden Content Template (Read by modal Javascript) -->
  <div class="client-card__details-hidden" style="display: none;">
    <div class="details-modal-header">
      <div class="modal-header-top">
        <div class="modal-logo-wrapper">
          <img src={logo} alt={name} class="modal-logo" />
        </div>
        <div class="modal-divisions">
          {divisions.map((div: string) => (
            <span class={`badge-division badge-division--${div}`}>{t[div]}</span>
          ))}
        </div>
      </div>
      <h3 class="modal-title">{name}</h3>
      <p class="modal-subtitle">{industry} &bull; {format}</p>
    </div>

    <div class="details-modal-body">
      <!-- Slot for rendered markdown body (bullet points, description) -->
      <slot />
    </div>

    <div class="details-modal-footer">
      {tech && tech.length > 0 && (
        <div class="modal-tech">
          <h4>{t.techTitle}</h4>
          <div class="tech-list">
            {tech.map((item: string) => (
              <span class="tech-badge">{item}</span>
            ))}
          </div>
        </div>
      )}
      {projectSlug && (
        <a href={`/projects/${projectSlug}`} class="btn btn--primary modal-case-link">
          {t.readCase}
          <Icon name="lucide:arrow-right" class="icon" />
        </a>
      )}
    </div>
  </div>
</div>

<style>
  .client-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(28, 25, 23, 0.08);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-base);
    backdrop-filter: blur(8px);
    overflow: hidden;
  }

  .client-card:hover {
    transform: translateY(-2px);
    border-color: rgba(28, 25, 23, 0.15);
    box-shadow: var(--shadow-md);
    background: rgba(255, 255, 255, 0.95);
  }

  /* Multi-disciplinary Dots */
  .client-card__dots {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    display: flex;
    gap: var(--space-1-5 || var(--space-1));
    z-index: 2;
  }

  .dot {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    box-shadow: 0 0 4px rgba(0,0,0,0.15);
    transition: transform var(--transition-fast);
  }

  .dot:hover {
    transform: scale(1.3);
  }

  /* Logo wrapper */
  .client-card__logo-wrapper {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    height: 48px;
    margin-bottom: var(--space-4);
  }

  .client-card__logo {
    max-height: 36px;
    width: auto;
    object-fit: contain;
    opacity: 0.6;
    filter: grayscale(100%);
    transition: all var(--transition-base);
  }

  .client-card:hover .client-card__logo {
    opacity: 1;
    filter: grayscale(0%);
  }

  /* Content */
  .client-card__content {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .client-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
  }

  .client-card__industry {
    color: var(--color-text-secondary);
    font-weight: var(--weight-medium);
  }

  .client-card__format {
    color: var(--color-text-muted);
  }

  .client-card__name {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .client-card__summary {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Tech tags */
  .client-card__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-bottom: var(--space-4);
  }

  .tech-badge {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
    background: var(--color-bg-hover);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(28, 25, 23, 0.05);
  }

  .tech-badge--more {
    font-weight: var(--weight-bold);
  }

  /* Footer */
  .client-card__footer {
    margin-top: auto;
    border-top: 1px solid rgba(28, 25, 23, 0.05);
    padding-top: var(--space-3);
  }

  .btn-more {
    background: none;
    border: none;
    padding: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    transition: color var(--transition-fast);
  }

  .btn-more:hover {
    color: var(--color-accent-hover);
  }

  .btn-more .icon {
    width: 14px;
    height: 14px;
    transition: transform var(--transition-fast);
  }

  .btn-more:hover .icon {
    transform: translate(1px, -1px);
  }
</style>
